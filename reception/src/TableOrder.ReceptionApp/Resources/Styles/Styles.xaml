<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:fonts="clr-namespace:Fonts">

    <!-- 形は角丸・影・グラデーションを使わず、四角い面と罫線と色の面で組む。色は Colors.xaml の役割の名前だけを使う -->
    <!-- チェーンの設定で替える色 (Brand・Neutral・Status) は DynamicResource で引く (スタイルはアプリの起動で作り、色は起動の画面で店舗の設定を読んでから替える) -->
    <!-- 起動・端末の設定・スタッフメニュー・電卓のスタイルは、TableOrder.Terminal の TerminalStyles にある -->
    <!-- お客様の画面は、入口に縦に置いたタブレット (約 873x1396dp) を立って使う受付機の組み方にする (テーブル端末の画面を流用しない) -->

    <!-- ================================================================================ -->
    <!-- Brand -->
    <!-- ================================================================================ -->

    <!-- ロゴは地の色を含む正方形の画像なので、印の面いっぱいに出す -->
    <Style x:Key="BrandLogoImage"
           TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Startup -->
    <!-- ================================================================================ -->

    <Style x:Key="StartupTitleStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="StartupAppLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Kiosk -->
    <!-- ================================================================================ -->

    <!-- お客様の画面 (待受、人数、案内) は、上にチェーンの帯、地の色の本文、下に画面の幅いっぱいの操作を置く -->
    <Style x:Key="KioskGrid"
           TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource CanvasColor}" />
    </Style>

    <!-- 上の帯は補助色の地に、チェーンの印・名前・店舗の名前を置く (待受は右に言語) -->
    <!-- 言語の列は出さないことがあるので、列の間は ColumnSpacing ではなく要素の Margin で空ける -->
    <Style x:Key="KioskHeaderGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="128" />
        <Setter Property="Padding" Value="40,0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryColor}" />
    </Style>

    <Style x:Key="KioskMarkBorder"
           TargetType="Border">
        <Setter Property="WidthRequest" Value="80" />
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <!-- ロゴがないときの印 (名前の頭の文字) -->
    <Style x:Key="KioskInitialLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
    </Style>

    <Style x:Key="KioskBrandStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Margin" Value="24,0,0,0" />
        <Setter Property="Spacing" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="KioskBrandLabel"
           TargetType="Label">
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSecondaryColor}" />
    </Style>

    <Style x:Key="KioskStoreLabel"
           TargetType="Label">
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="TextColor" Value="{DynamicResource OnSecondaryColor}" />
    </Style>

    <Style x:Key="KioskLanguageButton"
           TargetType="Button">
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="Margin" Value="24,0,0,0" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSecondaryColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryPressedColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 受付の段階 (1 人数、2 ご案内)。今の段階を主色の面にし、終えた段階は番号の代わりに印を出す -->
    <Style x:Key="KioskStepGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="96" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="KioskStepCellGrid"
           TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="KioskStepCurrentGrid"
           TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style x:Key="KioskStepStack"
           TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="16" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="KioskStepNumberLabel"
           TargetType="Label">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="KioskStepCurrentNumberLabel"
           TargetType="Label"
           BasedOn="{StaticResource KioskStepNumberLabel}">
        <Setter Property="BackgroundColor" Value="{DynamicResource OnPrimaryColor}" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style x:Key="KioskStepDoneNumberLabel"
           TargetType="Label"
           BasedOn="{StaticResource KioskStepNumberLabel}">
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="None" />
        <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
    </Style>

    <Style x:Key="KioskStepLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="KioskStepCurrentLabel"
           TargetType="Label"
           BasedOn="{StaticResource KioskStepLabel}">
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
    </Style>

    <!-- 本文は左右に 48 の余白を取り、文字は中央にそろえる -->
    <Style x:Key="KioskBodyGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="48,40,48,48" />
    </Style>

    <Style x:Key="KioskTitleLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="KioskLeadLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- 待受に戻るまでの時間などの添え書き -->
    <Style x:Key="KioskNoteLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- 下の操作は画面の幅いっぱいのボタンを縦に重ねる (主な操作を上の大きいボタンにする) -->
    <Style x:Key="KioskActionStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="KioskButtonBase"
           TargetType="Button">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="KioskPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource KioskButtonBase}">
        <Setter Property="HeightRequest" Value="128" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryPressedColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource DisabledColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnDisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 戻るは面の色に枠を付けた低いボタンにする (主な操作と取り違えないように) -->
    <Style x:Key="KioskSecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource KioskButtonBase}">
        <Setter Property="HeightRequest" Value="88" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource OutlineColor}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Standby -->
    <!-- ================================================================================ -->

    <Style x:Key="StandbyStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="40" />
    </Style>

    <Style x:Key="StandbyWelcomeStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="StandbyWelcomeLabel"
           TargetType="Label"
           BasedOn="{StaticResource KioskTitleLabel}">
        <Setter Property="FontSize" Value="72" />
    </Style>

    <!-- 受付の流れは、記号と番号と文言の面を 3 つ並べる -->
    <Style x:Key="StandbyStepsGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <Style x:Key="StandbyStepBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="12,28" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="StandbyStepStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style x:Key="StandbyStepGlyphLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style x:Key="StandbyStepNumberLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style x:Key="StandbyStepTextLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- 空席の状態は、記号の色 (すぐに案内できる・満席・受付を止めている) と文言を面に出す -->
    <Style x:Key="StandbyStatusBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="32,28" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="StandbyStatusGlyphLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,0,24,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="StandbyStatusLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="StandbyStatusStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="20" />
    </Style>

    <!-- 注文の一時停止は、受け付けられる状態に添えて注意の色で出す -->
    <Style x:Key="StandbyPausedGlyphLabel"
           TargetType="Label"
           BasedOn="{StaticResource StandbyStatusGlyphLabel}">
        <Setter Property="TextColor" Value="{DynamicResource WarningColor}" />
    </Style>

    <Style x:Key="StandbyPausedLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{DynamicResource WarningColor}" />
    </Style>

    <!-- 受付するは、立ったまま押せるように画面の下に大きく置く -->
    <Style x:Key="StandbyStartButton"
           TargetType="Button"
           BasedOn="{StaticResource KioskPrimaryButton}">
        <Setter Property="HeightRequest" Value="168" />
        <Setter Property="FontSize" Value="44" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Guests -->
    <!-- ================================================================================ -->

    <Style x:Key="GuestsStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="24" />
    </Style>

    <!-- 大人と子どもは面ごとに分け、名前の下に増減を画面の幅で並べる -->
    <Style x:Key="GuestsPanelBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="32,24" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="GuestsNameStack"
           TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="GuestsNameLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="GuestsNoteLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="GuestsStepperGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0,20,0,0" />
        <Setter Property="HeightRequest" Value="128" />
    </Style>

    <!-- 人数の増減。− と + は沈んだ面の四角いボタンにする -->
    <Style x:Key="GuestsStepperButton"
           TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource OutlineColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource DisabledColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnDisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="GuestsValueLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="72" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="GuestsTotalLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Guide -->
    <!-- ================================================================================ -->

    <Style x:Key="GuideStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="32" />
    </Style>

    <!-- 案内の記号 (案内できた / 満席) -->
    <Style x:Key="GuideGlyphLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="96" />
        <Setter Property="TextColor" Value="{DynamicResource SuccessColor}" />
    </Style>

    <Style x:Key="GuideFullGlyphLabel"
           TargetType="Label"
           BasedOn="{StaticResource GuideGlyphLabel}">
        <Setter Property="TextColor" Value="{DynamicResource WarningColor}" />
    </Style>

    <!-- 決まったテーブルは主色の札にして、離れても読める大きさで出す -->
    <Style x:Key="GuideTicketBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="40,32,40,40" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style x:Key="GuideTicketCaptionLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="Opacity" Value="0.85" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
    </Style>

    <Style x:Key="GuideTicketTableLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="160" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
    </Style>

    <Style x:Key="GuideGuestsLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="GuideMessageLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="GuidePausedLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource WarningColor}" />
    </Style>

    <!-- 待受に戻るまでの残りは、減っていく帯で示す (帯の左を起点に縮める) -->
    <Style x:Key="GuideCountdownGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="8" />
    </Style>

    <Style x:Key="GuideCountdownTrack"
           TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource SurfaceVariantColor}" />
    </Style>

    <Style x:Key="GuideCountdownBar"
           TargetType="BoxView">
        <Setter Property="AnchorX" Value="0" />
        <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Language -->
    <!-- ================================================================================ -->

    <Style x:Key="LanguageListStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <!-- 押せる面の高さは主な操作と同じ 80 にする -->
    <Style x:Key="LanguageTileBorder"
           TargetType="Border">
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="LanguageNameLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="OptionCheckLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

</ResourceDictionary>
