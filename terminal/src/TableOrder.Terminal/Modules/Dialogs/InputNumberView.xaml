<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:s="http://smart/maui"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           xmlns:strings="clr-namespace:TableOrder.Terminal.Resources.Strings"
           xmlns:styles="clr-namespace:TableOrder.Terminal.Resources.Styles"
           xmlns:module="clr-namespace:TableOrder.Terminal.Modules.Dialogs"
           x:Class="TableOrder.Terminal.Modules.Dialogs.InputNumberView"
           x:DataType="{x:Type module:InputNumberViewModel}"
           s:BindingContextResolver.Type="{x:Type module:InputNumberViewModel}"
           WidthRequest="{x:Static styles:TerminalSizes.Keypad}">

    <!-- 電卓は罫線で区切った四角いキーにする (キーの間隔から背景の罫線の色を見せる)。スタッフと端末の設定で使うのでシステムの色にする -->
    <VerticalStackLayout Style="{StaticResource KeypadStack}">
        <!-- title (チェーンの色の役割を使わない) -->
        <Label Style="{StaticResource KeypadTitleLabel}"
               Text="{Binding Title}" />

        <BoxView Style="{StaticResource SystemRule}" />

        <!-- display -->
        <Label Style="{StaticResource InputDisplayLabel}"
               Text="{Binding Input.DisplayText}" />

        <!-- pad -->
        <Grid Style="{StaticResource KeypadGrid}"
              RowDefinitions="80,80,80,80"
              ColumnDefinitions="*,*,*">
            <Button Grid.Row="0" Grid.Column="0"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="1"
                    Text="1" />
            <Button Grid.Row="0" Grid.Column="1"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="2"
                    Text="2" />
            <Button Grid.Row="0" Grid.Column="2"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="3"
                    Text="3" />

            <Button Grid.Row="1" Grid.Column="0"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="4"
                    Text="4" />
            <Button Grid.Row="1" Grid.Column="1"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="5"
                    Text="5" />
            <Button Grid.Row="1" Grid.Column="2"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="6"
                    Text="6" />

            <Button Grid.Row="2" Grid.Column="0"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="7"
                    Text="7" />
            <Button Grid.Row="2" Grid.Column="1"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="8"
                    Text="8" />
            <Button Grid.Row="2" Grid.Column="2"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="9"
                    Text="9" />

            <Button Grid.Row="3" Grid.Column="0"
                    Style="{StaticResource KeypadCommandButton}"
                    Command="{Binding ClearCommand}"
                    Text="AC" />
            <Button Grid.Row="3" Grid.Column="1"
                    Style="{StaticResource KeypadButton}"
                    Command="{Binding PushCommand}"
                    CommandParameter="0"
                    Text="0" />
            <Button Grid.Row="3" Grid.Column="2"
                    Style="{StaticResource KeypadCommandButton}"
                    Command="{Binding PopCommand}"
                    Text="C" />
        </Grid>

        <!-- action -->
        <Grid Style="{StaticResource KeypadActionGrid}"
              ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Style="{StaticResource KeypadCancelButton}"
                    Command="{Binding CloseCommand}"
                    Text="{x:Static strings:TerminalResources.CommonCancel}" />
            <Button Grid.Column="1"
                    Style="{StaticResource KeypadOkButton}"
                    Command="{Binding CommitCommand}"
                    Text="{x:Static strings:TerminalResources.CommonOk}" />
        </Grid>
    </VerticalStackLayout>

</mct:Popup>
