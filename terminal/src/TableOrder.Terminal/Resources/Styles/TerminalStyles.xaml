<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:s="http://smart/maui"
                    xmlns:behaviors="clr-namespace:TableOrder.Terminal.Behaviors"
                    xmlns:styles="clr-namespace:TableOrder.Terminal.Resources.Styles"
                    x:Class="TableOrder.Terminal.Resources.Styles.TerminalStyles">

    <!-- どの端末でも同じスタイル (変換器、基本の配置、システムの画面、ダイアログの基本、既定、電卓)。アプリの App.xaml で、アプリの色の辞書の後、アプリのスタイルの辞書の前に入れる -->
    <!-- 形は角丸・影・グラデーションを使わず、四角い面と罫線と色の面で組む。色は役割の名前だけを使う -->
    <!-- System の役割の色は中に入れた SystemColors から StaticResource で引き、アプリが替える役割の色 (Brand・Neutral・Status) は DynamicResource で引く (値はアプリの色の辞書にある) -->

    <ResourceDictionary.MergedDictionaries>
        <styles:SystemColors />
    </ResourceDictionary.MergedDictionaries>


    <!-- ================================================================================ -->
    <!-- Converter -->
    <!-- ================================================================================ -->

    <!-- Basic -->

    <s:ReverseConverter x:Key="ReverseConverter" />

    <s:NullToBoolConverter x:Key="NotEmptyConverter"
                           HandleEmptyString="True"
                           NullValue="False"
                           NonNullValue="True" />

    <s:CompareToBoolConverter x:Key="GreaterThanToBoolConverter"
                              Expression="{x:Static s:CompareExpressions.GreaterThan}" />

    <s:ColorToBrushConverter x:Key="ColorToBrushConverter" />

    <!-- ================================================================================ -->
    <!-- Main -->
    <!-- ================================================================================ -->

    <Style x:Key="MainGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <!-- 画面を切り替える間に見える地は、起動の画面とスプラッシュの地に揃える -->
    <Style x:Key="ContainerLayout"
           TargetType="AbsoluteLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Layout -->
    <!-- ================================================================================ -->

    <Style x:Key="ScreenGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource CanvasColor}" />
    </Style>

    <Style x:Key="FillGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <!-- 面 (注文リスト、明細、支払) -->
    <Style x:Key="PanelGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <!-- 縦にスクロールする面 (商品の詳細、端末の設定、スタッフメニュー)。端まで来ても伸びる効果を出さない -->
    <Style x:Key="PanelScroll"
           TargetType="ScrollView">
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <!-- 面の区切りは 1 本の罫線にする -->

    <Style x:Key="HorizontalRule"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource OutlineColor}" />
    </Style>

    <Style x:Key="VerticalRule"
           TargetType="BoxView">
        <Setter Property="WidthRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource OutlineColor}" />
    </Style>

    <!-- 一覧の行の間の薄い区切り -->
    <Style x:Key="HorizontalVariantRule"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{DynamicResource OutlineVariantColor}" />
    </Style>

    <Style x:Key="LoadingIndicator"
           TargetType="ActivityIndicator">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- System -->
    <!-- ================================================================================ -->

    <!-- 起動、端末の設定、スタッフメニュー。チェーンの色を使わず、System の役割の色で組む -->

    <Style x:Key="SystemScreenGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
    </Style>

    <Style x:Key="SystemHeaderGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
    </Style>

    <Style x:Key="SystemHeaderLogoImage"
           TargetType="Image">
        <Setter Property="Margin" Value="24,0,16,0" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SystemHeaderLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SystemRule"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource SystemOutlineColor}" />
    </Style>

    <Style x:Key="SystemLogoImage"
           TargetType="Image">
        <Setter Property="WidthRequest" Value="120" />
        <Setter Property="HeightRequest" Value="120" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="SystemWordmarkLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SystemFooterLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="SystemButtonBase"
           TargetType="Button">
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="SystemPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource SystemButtonBase}">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemAccentColor}" />
                            <Setter Property="TextColor" Value="{StaticResource OnSystemAccentColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemAccentPressedColor}" />
                            <Setter Property="TextColor" Value="{StaticResource OnSystemAccentColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemOutlineColor}" />
                            <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SystemSecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource SystemButtonBase}">
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{StaticResource SystemOutlineColor}" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Startup -->

    <Style x:Key="StartupStack"
           TargetType="VerticalStackLayout">
        <Setter Property="WidthRequest" Value="{x:Static styles:TerminalSizes.Startup}" />
        <Setter Property="Spacing" Value="20" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!-- 進み具合は罫線の太さの帯にし、伸ばす帯は左端から ScaleX で伸ばす -->
    <Style x:Key="StartupProgressGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0,28,0,0" />
        <Setter Property="HeightRequest" Value="4" />
    </Style>

    <Style x:Key="StartupProgressTrack"
           TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource SystemOutlineColor}" />
    </Style>

    <Style x:Key="StartupProgressBar"
           TargetType="BoxView">
        <Setter Property="AnchorX" Value="0" />
        <Setter Property="Color" Value="{StaticResource SystemAccentColor}" />
    </Style>

    <Style x:Key="StartupStepLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="StartupActionGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <Style x:Key="StartupHintLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <!-- Setup -->

    <Style x:Key="SetupFormStack"
           TargetType="VerticalStackLayout">
        <Setter Property="WidthRequest" Value="{x:Static styles:TerminalSizes.Setup}" />
        <Setter Property="Padding" Value="0,48" />
        <Setter Property="Spacing" Value="40" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="SetupFieldStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="10" />
    </Style>

    <Style x:Key="SetupFieldLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SetupValueBorder"
           TargetType="Border">
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Stroke" Value="{StaticResource SystemOutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
    </Style>

    <Style x:Key="SetupValueLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="24,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SetupChangeButton"
           TargetType="Button">
        <Setter Property="WidthRequest" Value="160" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemOutlineColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SetupHintLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <!-- EMM が配っている値。入力欄と同じ大きさにし、地を画面と同じ色にして入れられないことを示す -->
    <Style x:Key="SetupManagedBorder"
           TargetType="Border">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Stroke" Value="{StaticResource SystemOutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
    </Style>

    <Style x:Key="SetupManagedLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SetupEntry"
           TargetType="Entry">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
        <Setter Property="behaviors:Border.Color" Value="{StaticResource SystemOutlineColor}" />
        <Setter Property="behaviors:Border.Width" Value="1" />
        <Setter Property="behaviors:Border.Padding" Value="20,12" />
    </Style>

    <Style x:Key="SetupSaveButton"
           TargetType="Button"
           BasedOn="{StaticResource SystemPrimaryButton}">
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- Staff -->

    <Style x:Key="SystemVerticalRule"
           TargetType="BoxView">
        <Setter Property="WidthRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource SystemOutlineColor}" />
    </Style>

    <Style x:Key="StaffPanelStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="32,16,32,32" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="StaffSectionLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="StaffInfoGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="16" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <Style x:Key="StaffInfoNameLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="StaffInfoValueLabel"
           TargetType="Label">
        <Setter Property="LineBreakMode" Value="CharacterWrap" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="StaffButtonGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="12" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <Style x:Key="StaffButton"
           TargetType="Button"
           BasedOn="{StaticResource SystemSecondaryButton}">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="StaffHintLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="StaffCloseButton"
           TargetType="Button"
           BasedOn="{StaticResource SystemPrimaryButton}">
        <Setter Property="HeightRequest" Value="80" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Dialog -->
    <!-- ================================================================================ -->

    <!-- ポップアップは画面の中央の四角い面。表題の帯、本文、罫線、同じ大きさのボタンの帯で組む -->

    <Style x:Key="DialogStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Spacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="DialogGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="DialogTitleLabel"
           TargetType="Label">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="DialogMessageLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="24,28" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="DialogLeadLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="DialogBodyStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Spacing" Value="16" />
    </Style>

    <Style x:Key="DialogTotalGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="DialogErrorLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ErrorColor}" />
    </Style>

    <Style x:Key="DialogActionGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="ColumnSpacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource OutlineColor}" />
    </Style>

    <Style x:Key="ActionButtonBase"
           TargetType="Button">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="PrimaryActionButton"
           TargetType="Button"
           BasedOn="{StaticResource ActionButtonBase}">
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryPressedColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource DisabledColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnDisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 受ける / 断るのボタンは同じ大きさにし、断る側を目立たなくしすぎない -->
    <Style x:Key="SecondaryActionButton"
           TargetType="Button"
           BasedOn="{StaticResource ActionButtonBase}">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Label -->
    <!-- ================================================================================ -->

    <!-- Default -->

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Number input -->
    <!-- ================================================================================ -->

    <!-- 電卓はスタッフと端末の設定で使うので、システムの色で組む -->

    <Style x:Key="KeypadStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
    </Style>

    <Style x:Key="KeypadTitleLabel"
           TargetType="Label"
           BasedOn="{StaticResource DialogTitleLabel}">
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="InputDisplayLabel"
           TargetType="Label">
        <Setter Property="Padding" Value="24,12" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
    </Style>

    <Style x:Key="KeypadGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="1" />
        <Setter Property="ColumnSpacing" Value="1" />
        <Setter Property="Padding" Value="0,1" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemOutlineColor}" />
    </Style>

    <Style x:Key="KeypadButton"
           TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="KeypadCommandButton"
           TargetType="Button"
           BasedOn="{StaticResource KeypadButton}">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="KeypadActionGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="ColumnSpacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemOutlineColor}" />
    </Style>

    <Style x:Key="KeypadCancelButton"
           TargetType="Button"
           BasedOn="{StaticResource KeypadCommandButton}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="KeypadOkButton"
