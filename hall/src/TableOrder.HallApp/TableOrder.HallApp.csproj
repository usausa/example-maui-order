<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>TableOrder.HallApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
    <MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
    <MauiXamlInflator>SourceGen</MauiXamlInflator>
    <CodeAnalysisRuleSet>..\..\..\Analyzers.ruleset</CodeAnalysisRuleSet>

    <!-- 画面の文言は日本語を既定 (AppResources.resx) にし、英語を AppResources.en.resx に置く -->
    <NeutralLanguage>ja</NeutralLanguage>

    <!-- Display name -->
    <ApplicationTitle>TableOrder Hall</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>tableorder.terminal.hall</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <!-- Device Owner は adb から外せないので、Debug だけ testOnly にして外せるようにする (Release は端末の初期化でしか外せない) -->
  <!-- 開発のサーバ (http) につなぐため、Debug だけ暗号化しない通信を許す (Release の接続先は https にする) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidManifestPlaceholders>testOnly=true;cleartext=true</AndroidManifestPlaceholders>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <AndroidManifestPlaceholders>testOnly=false;cleartext=false</AndroidManifestPlaceholders>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
    <AndroidKeyStore>True</AndroidKeyStore>
    <AndroidSigningKeyStore>example.keystore</AndroidSigningKeyStore>
    <AndroidSigningKeyAlias>example</AndroidSigningKeyAlias>
    <AndroidSigningKeyPass>example</AndroidSigningKeyPass>
    <AndroidSigningStorePass>example</AndroidSigningStorePass>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="1" />
    <!-- Splash Screen (起動の画面の地 SystemCanvasColor と同じ色) -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#F4F5F7" BaseSize="128,128" />
    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\Strings\AppResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>AppResources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Resources\Strings\AppResources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>AppResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\TableOrder.Client\TableOrder.Client.csproj" />
    <ProjectReference Include="..\..\..\terminal\src\TableOrder.Terminal\TableOrder.Terminal.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BunnyTail.DependencyInjection" Version="0.8.0" />
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="Components.Maui" Version="1.48.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">none</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.110" />
    <PackageReference Include="System.Reactive" Version="7.0.0" />
    <PackageReference Include="Usa.Smart.Core" Version="2.20.0" />
    <PackageReference Include="Usa.Smart.Maui" Version="2.32.0" />
    <PackageReference Include="Usa.Smart.Maui.Extensions" Version="2.32.0" />
    <PackageReference Include="Usa.Smart.Mvvm" Version="2.16.0" />
    <PackageReference Include="Usa.Smart.Navigation" Version="3.15.0" />
    <PackageReference Include="Usa.Smart.Navigation.Extensions.DependencyInjection" Version="3.15.0" />
    <PackageReference Include="Usa.Smart.Navigation.Maui" Version="3.15.0" />
    <PackageReference Include="Usa.Smart.Reactive" Version="2.15.0" />
  </ItemGroup>

</Project>
