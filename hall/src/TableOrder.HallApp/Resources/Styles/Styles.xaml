<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:behaviors="clr-namespace:TableOrder.Terminal.Behaviors;assembly=TableOrder.Terminal"
                    xmlns:fonts="clr-namespace:Fonts">

    <!-- ホール端末の画面のスタイル (どの端末でも同じスタイルは TableOrder.Terminal の TerminalStyles) -->
    <!-- 形は角丸・影・グラデーションを使わず、四角い面と罫線と色の面で組む。色は Colors.xaml の役割の名前だけを使う -->
    <!-- Brand・Neutral・Status の役割は DynamicResource で引く (テーブル端末と同じ書き方にする)。System の役割は StaticResource で引く -->

    <!-- ================================================================================ -->
    <!-- System -->
    <!-- ================================================================================ -->

    <!-- 縦長の画面で使う、起動と端末の画面の部品 -->

    <Style x:Key="SystemBackButton"
           TargetType="Button">
        <Setter Property="WidthRequest" Value="72" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Startup -->

    <Style x:Key="StartupTitleStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="4" />
    </Style>

    <Style x:Key="StartupAppLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="StartupActionStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <!-- Device -->

    <Style x:Key="DevicePanelStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="16,8,16,32" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Header -->
    <!-- ================================================================================ -->

    <Style x:Key="HeaderStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="HeaderGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="HeaderTitleLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="16,0,12,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="HeaderCaptionLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="HeaderButton"
           TargetType="Button">
        <Setter Property="WidthRequest" Value="64" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 店舗の知らせ (注文の一時停止)。ヘッダの下の帯にする -->

    <Style x:Key="NoticeGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="ColumnSpacing" Value="10" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WarningColor}" />
    </Style>

    <Style x:Key="NoticeGlyphLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="TextColor" Value="{DynamicResource OnWarningColor}" />
    </Style>

    <Style x:Key="NoticeLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnWarningColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Tab -->
    <!-- ================================================================================ -->

    <!-- 一覧が空のときの知らせ -->
    <Style x:Key="EmptyLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- タブの画面の一覧 (タイルとカード)。見出しと末尾にも項目の間隔の半分ずつが入るので、高さ 0 の行を置くだけで上下の余白が項目の間隔と揃う -->

    <Style x:Key="TileCollectionView"
           TargetType="CollectionView">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <Style x:Key="TileGapBoxView"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="0" />
    </Style>

    <Style x:Key="CardBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <!-- 下の帯の操作 (来店の詳細、品切れのタブ)。押せる面は 64dp にする (来店を終える操作は主な操作として 80dp) -->
    <Style x:Key="ActionBarGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="ActionBarButton"
           TargetType="Button">
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource DisabledColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnDisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- カードの中の操作。押せる面は 64dp にし、主な操作は主色、ほかは沈んだ面にする -->

    <Style x:Key="CardPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryActionButton}">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <Style x:Key="CardButton"
           TargetType="Button">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource OutlineColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource DisabledColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnDisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 下部のタブの帯。押せる面は 72dp の高さにする -->

    <Style x:Key="TabBarGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="TabItemGrid"
           TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <!-- 選んでいるタブの上の線 -->
    <Style x:Key="TabIndicator"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="3" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="Color" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style x:Key="TabItemStack"
           TargetType="VerticalStackLayout">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Spacing" Value="2" />
    </Style>

    <Style x:Key="TabGlyphLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="TabTextLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- 待っている件数。記号の右上に重ねる -->
    <Style x:Key="TabBadgeBorder"
           TargetType="Border">
        <Setter Property="MinimumWidthRequest" Value="22" />
        <Setter Property="HeightRequest" Value="20" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="TranslationX" Value="18" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ErrorColor}" />
    </Style>

    <Style x:Key="TabBadgeLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnErrorColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Seat -->
    <!-- ================================================================================ -->

    <Style x:Key="SeatTileBorder"
           TargetType="Border"
           BasedOn="{StaticResource CardBorder}">
        <Setter Property="HeightRequest" Value="104" />
    </Style>

    <!-- 状態の帯 (空きは罫線の色。来店中と会計中はトリガで替える) -->
    <Style x:Key="SeatStripBoxView"
           TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource OutlineColor}" />
    </Style>

    <Style x:Key="SeatTileGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="RowSpacing" Value="2" />
    </Style>

    <Style x:Key="SeatNameLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="SeatSizeLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="SeatStatusLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="SeatElapsedLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="SeatCountStack"
           TargetType="HorizontalStackLayout">
        <Setter Property="Spacing" Value="8" />
        <Setter Property="VerticalOptions" Value="End" />
    </Style>

    <Style x:Key="SeatUnservedLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- 終わっていない呼び出しは、タブの件数と同じ色の面にして目立たせる -->
    <Style x:Key="SeatCallBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource ErrorColor}" />
    </Style>

    <Style x:Key="SeatCallLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnErrorColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Visit -->
    <!-- ================================================================================ -->

    <Style x:Key="VisitStatusLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="8,0,16,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="VisitBodyStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="16,16,16,24" />
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="VisitSummaryGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="16" />
        <Setter Property="RowSpacing" Value="12" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="VisitInfoNameLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="VisitInfoValueLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="VisitSectionLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="VisitEmptyLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="VisitErrorLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource ErrorColor}" />
    </Style>

    <Style x:Key="VisitOrderListStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="12" />
    </Style>

    <Style x:Key="VisitOrderStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Spacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="VisitOrderTitleGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="0,4" />
    </Style>

    <Style x:Key="VisitOrderTitleLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="VisitOrderTimeLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="VisitLineGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="0,8" />
    </Style>

    <Style x:Key="VisitLineNameStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- 注文の内容は省略せずに折り返して全部見せる -->
    <Style x:Key="VisitLineNameLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="VisitLineOptionLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="VisitLineQuantityLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="VisitLineStatusLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="12,0,0,0" />
        <Setter Property="WidthRequest" Value="88" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="VisitCloseButton"
           TargetType="Button"
           BasedOn="{StaticResource PrimaryActionButton}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="VisitCancelButton"
           TargetType="Button"
           BasedOn="{StaticResource ActionBarButton}">
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Call -->
    <!-- ================================================================================ -->

    <!-- 状態の帯 (呼ばれている間は注意の色。向かっている間はトリガで替える) -->
    <Style x:Key="CallStripBoxView"
           TargetType="BoxView">
        <Setter Property="Color" Value="{DynamicResource ErrorColor}" />
    </Style>

    <!-- 操作の列は状態で中身を替えるので、列の間は ColumnSpacing ではなく要素の Margin で空ける -->
    <Style x:Key="CallCardGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="12,10,12,12" />
        <Setter Property="RowSpacing" Value="2" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="CallTableLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="CallElapsedLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="CallReasonLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="CallAcknowledgeButton"
           TargetType="Button"
           BasedOn="{StaticResource CardPrimaryButton}">
        <Setter Property="Margin" Value="0,10,4,0" />
    </Style>

    <Style x:Key="CallAcknowledgedLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,10,4,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="CallCompleteButton"
           TargetType="Button"
           BasedOn="{StaticResource CardButton}">
        <Setter Property="Margin" Value="4,10,0,0" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Serving -->
    <!-- ================================================================================ -->

    <!-- すべて提供したは明細が 2 つ以上のときだけ出すので、列の間は ColumnSpacing ではなくボタンの Margin で空ける -->
    <Style x:Key="ServingTitleGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="Padding" Value="12,0,0,0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="ServingTableLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="ServingAllButton"
           TargetType="Button"
           BasedOn="{StaticResource CardPrimaryButton}">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="Padding" Value="16,0" />
    </Style>

    <Style x:Key="ServingLineListStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="12,4" />
    </Style>

    <!-- 注文の内容は省略せずに折り返して全部見せる -->
    <Style x:Key="ServingLineGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="ServingLineNameStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ServingLineNameLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="ServingLineOptionLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="ServingLineCountStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="ServingLineQuantityLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="ServingLineElapsedLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="End" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="ServingLineButton"
           TargetType="Button"
           BasedOn="{StaticResource CardButton}">
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Stock -->
    <!-- ================================================================================ -->

    <!-- カテゴリの帯。区切り線の色を間隔から見せ、最後のタブの右にも区切り線を出す -->

    <Style x:Key="StockCategoryScroll"
           TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <Style x:Key="StockCategoryStack"
           TargetType="HorizontalStackLayout">
        <Setter Property="Padding" Value="0,0,1,0" />
        <Setter Property="Spacing" Value="1" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="{DynamicResource OutlineColor}" />
    </Style>

    <Style x:Key="StockCategoryBorder"
           TargetType="Border">
        <Setter Property="MinimumWidthRequest" Value="96" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="StockCategoryLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- 帯が続いている向きの端に重ねる送りのボタン (押すとその向きへ送る)。タブとは罫線で分ける -->
    <Style x:Key="StockPagerGrid"
           TargetType="Grid">
        <Setter Property="WidthRequest" Value="49" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="StockPagerLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- 品の一覧。押せる面は 64dp 以上にし、品の間は罫線で分ける -->

    <Style x:Key="StockCollectionView"
           TargetType="CollectionView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <Style x:Key="StockRowGrid"
           TargetType="Grid">
        <Setter Property="MinimumHeightRequest" Value="64" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="StockRowContentGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="StockRowNameStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="2" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="StockRowNameLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="StockRowCaptionLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- 残りの数は注意の色、品切れはトリガで危険の色にする -->
    <Style x:Key="StockRowStatusLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource WarningColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Dialog -->
    <!-- ================================================================================ -->

    <Style x:Key="DialogHintLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- Guest -->

    <Style x:Key="GuestRowGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="0,8" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="GuestNameStack"
           TargetType="VerticalStackLayout">
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="GuestNameLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="GuestHintLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- 人数の増減。- と + は沈んだ面の四角いボタンにする -->

    <Style x:Key="StepperGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="StepperButton"
           TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource OutlineColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource DisabledColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnDisabledColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="StepperValueLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- Choice -->

    <!-- 選択肢が多いときは、ポップアップが画面からはみ出さないようにスクロールさせる -->
    <Style x:Key="ChoiceListScroll"
           TargetType="ScrollView">
        <Setter Property="MaximumHeightRequest" Value="440" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <Style x:Key="ChoiceListStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="16" />
        <Setter Property="Spacing" Value="8" />
    </Style>

    <Style x:Key="ChoiceTileBorder"
           TargetType="Border">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Stroke" Value="{DynamicResource OutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="ChoiceNameLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="ChoiceCaptionLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- 今の状態の選択肢に付ける印 -->
    <Style x:Key="ChoiceCheckLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <!-- Stock -->

    <Style x:Key="StockEditStatusLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

</ResourceDictionary>
