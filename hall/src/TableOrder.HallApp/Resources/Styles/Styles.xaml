<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- 形は角丸・影・グラデーションを使わず、四角い面と罫線と色の面で組む。色は Colors.xaml の役割の名前だけを使う -->

    <!-- ================================================================================ -->
    <!-- Main -->
    <!-- ================================================================================ -->

    <Style x:Key="MainGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <Style x:Key="ContainerLayout"
           TargetType="AbsoluteLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- System -->
    <!-- ================================================================================ -->

    <Style x:Key="SystemScreenGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
    </Style>

    <Style x:Key="SystemHeaderGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
    </Style>

    <Style x:Key="SystemHeaderLogoImage"
           TargetType="Image">
        <Setter Property="Margin" Value="24,0,16,0" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SystemHeaderLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SystemRule"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource SystemOutlineColor}" />
    </Style>

    <Style x:Key="SystemFooterLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Home -->
    <!-- ================================================================================ -->

    <Style x:Key="HomeMessageLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

</ResourceDictionary>
