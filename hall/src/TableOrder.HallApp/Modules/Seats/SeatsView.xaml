<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:controls="clr-namespace:TableOrder.HallApp.Controls"
             xmlns:strings="clr-namespace:TableOrder.HallApp.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.HallApp.Modules.Seats"
             x:Class="TableOrder.HallApp.Modules.Seats.SeatsView"
             x:DataType="{x:Type module:SeatsViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SeatsViewModel}">

    <!-- 席のタブ: 席の一覧 (空き・来店中・会計中、人数、経過時間、まだ出していない品、呼び出し)。中身はこれから作る -->
    <Grid Style="{StaticResource ScreenGrid}"
          RowDefinitions="Auto,*,Auto">
        <controls:TabHeader Grid.Row="0" />

        <Label Grid.Row="1"
               Style="{StaticResource PendingLabel}"
               Text="{x:Static strings:AppResources.TabPending}" />

        <controls:TabFooter Grid.Row="2" />
    </Grid>

</ContentView>
