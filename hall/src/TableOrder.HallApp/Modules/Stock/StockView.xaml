<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:controls="clr-namespace:TableOrder.HallApp.Controls"
             xmlns:strings="clr-namespace:TableOrder.HallApp.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.HallApp.Modules.Stock"
             x:Class="TableOrder.HallApp.Modules.Stock.StockView"
             x:DataType="{x:Type module:StockViewModel}"
             s:BindingContextResolver.Type="{x:Type module:StockViewModel}">

    <!-- 品切れのタブ: 品ごとの売り切れと残りの数、注文の一時停止。中身はこれから作る -->
    <Grid Style="{StaticResource ScreenGrid}"
          RowDefinitions="Auto,*,Auto">
        <controls:TabHeader Grid.Row="0" />

        <Label Grid.Row="1"
               Style="{StaticResource PendingLabel}"
               Text="{x:Static strings:AppResources.TabPending}" />

        <controls:TabFooter Grid.Row="2" />
    </Grid>

</ContentView>
