<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:behaviors="clr-namespace:TableOrder.Terminal.Behaviors;assembly=TableOrder.Terminal"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:strings="clr-namespace:TableOrder.HallApp.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.HallApp.Modules.Order"
             x:Class="TableOrder.HallApp.Modules.Order.OrderView"
             x:DataType="{x:Type module:OrderViewModel}"
             s:BindingContextResolver.Type="{x:Type module:OrderViewModel}">

    <!-- 代わりの注文: カテゴリの帯 (カート、メニューのカテゴリ) で選んだ品を並べ、品を押すと詳細で選んでカートに入れる。カートの品を押すと外す。下に注文する (点数と合計) を置く -->
    <Grid Style="{StaticResource ScreenGrid}"
          RowDefinitions="Auto,Auto,64,1,*,Auto">
        <!-- header -->
        <VerticalStackLayout Grid.Row="0"
                             Style="{StaticResource HeaderStack}">
            <Grid Style="{StaticResource HeaderGrid}"
                  ColumnDefinitions="Auto,*">
                <Button Grid.Column="0"
                        Style="{StaticResource HeaderButton}"
                        Command="{Binding BackCommand}"
                        Text="{x:Static fonts:MaterialIcons.Arrow_back}" />
                <Label Grid.Column="1"
                       Style="{StaticResource HeaderTitleLabel}"
                       Text="{Binding TitleText}" />
            </Grid>
            <BoxView Style="{StaticResource HorizontalRule}" />
        </VerticalStackLayout>

        <!-- notice -->
        <Grid Grid.Row="1"
              Style="{StaticResource NoticeGrid}"
              ColumnDefinitions="Auto,*"
              IsVisible="{Binding IsOrderingPaused}">
            <Label Grid.Column="0"
                   Style="{StaticResource NoticeGlyphLabel}"
                   Text="{x:Static fonts:MaterialIcons.Pause_circle_outline}" />
            <Label Grid.Column="1"
                   Style="{StaticResource NoticeLabel}"
                   Text="{x:Static strings:AppResources.NoticeOrderingPaused}" />
        </Grid>

        <!-- category (横にスクロールする。帯が続いている向きの端に送りのボタンを重ねる) -->
        <Grid Grid.Row="2"
              Style="{StaticResource FillGrid}">
            <ScrollView x:Name="CategoryScroll"
                        Style="{StaticResource CategoryBarScroll}"
                        Orientation="Horizontal"
                        HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Style="{StaticResource CategoryBarStack}"
                                       BindableLayout.ItemsSource="{Binding Categories}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type module:OrderCategory}">
                            <Border Style="{StaticResource CategoryTabBorder}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border"
                                                 Binding="{Binding IsSelected}"
                                                 Value="True">
                                        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:OrderViewModel}}, Path=SelectCategoryCommand, x:DataType={x:Type module:OrderViewModel}}"
                                                          CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                                <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                                <Label Style="{StaticResource CategoryTabLabel}"
                                       Text="{Binding Name}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSelected}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            <Grid Style="{StaticResource CategoryPagerGrid}"
                  ColumnDefinitions="*,1"
                  behaviors:ScrollPager.Forward="False"
                  behaviors:ScrollPager.Target="{x:Reference CategoryScroll}"
                  HorizontalOptions="Start">
                <Label Grid.Column="0"
                       Style="{StaticResource CategoryPagerLabel}"
                       Text="{x:Static fonts:MaterialIcons.Chevron_left}" />
                <BoxView Grid.Column="1"
                         Style="{StaticResource VerticalRule}" />
            </Grid>
            <Grid Style="{StaticResource CategoryPagerGrid}"
                  ColumnDefinitions="1,*"
                  behaviors:ScrollPager.Target="{x:Reference CategoryScroll}"
                  HorizontalOptions="End">
                <BoxView Grid.Column="0"
                         Style="{StaticResource VerticalRule}" />
                <Label Grid.Column="1"
                       Style="{StaticResource CategoryPagerLabel}"
                       Text="{x:Static fonts:MaterialIcons.Chevron_right}" />
            </Grid>
        </Grid>
        <BoxView Grid.Row="3"
                 Style="{StaticResource HorizontalRule}" />

        <!-- item / cart -->
        <CollectionView Grid.Row="4"
                        Style="{StaticResource ListCollectionView}"
                        ItemsSource="{Binding Rows}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:OrderRow}">
                    <Grid Style="{StaticResource ListRowGrid}"
                          RowDefinitions="*,1">
                        <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type module:OrderViewModel}}, Path=SelectRowCommand, x:DataType={x:Type module:OrderViewModel}}"
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                        <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                        <Grid Grid.Row="0"
                              Style="{StaticResource ListRowContentGrid}"
                              ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0"
                                                 Style="{StaticResource ListRowNameStack}">
                                <Label Style="{StaticResource ListRowNameLabel}"
                                       Text="{Binding Name}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSoldOut}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource OnDisabledColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Style="{StaticResource ListRowCaptionLabel}"
                                       IsVisible="{Binding HasCaption}"
                                       Text="{Binding Caption}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Style="{StaticResource ListRowNameStack}">
                                <Label Style="{StaticResource OrderRowPriceLabel}"
                                       Text="{Binding PriceText}" />
                                <Label Style="{StaticResource OrderRowStatusLabel}"
                                       IsVisible="{Binding StatusText, Converter={StaticResource NotEmptyConverter}}"
                                       Text="{Binding StatusText}">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding IsSoldOut}"
                                                     Value="True">
                                            <Setter Property="TextColor" Value="{DynamicResource ErrorColor}" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Grid.Row="1"
                                 Style="{StaticResource HorizontalVariantRule}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label Grid.Row="4"
               Style="{StaticResource EmptyLabel}"
               IsVisible="{Binding IsEmpty}"
               Text="{Binding EmptyText}" />

        <!-- submit -->
        <Grid Grid.Row="5"
              Style="{StaticResource ActionBarGrid}"
              RowDefinitions="1,72">
            <BoxView Grid.Row="0"
                     Style="{StaticResource HorizontalRule}" />
            <Button Grid.Row="1"
                    Style="{StaticResource OrderSubmitButton}"
                    Command="{Binding SubmitCommand}"
                    Text="{Binding SubmitText}" />
        </Grid>
    </Grid>

</ContentView>
