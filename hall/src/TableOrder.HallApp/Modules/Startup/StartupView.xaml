<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:strings="clr-namespace:TableOrder.HallApp.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.HallApp.Modules.Startup"
             x:Class="TableOrder.HallApp.Modules.Startup.StartupView"
             x:DataType="{x:Type module:StartupViewModel}"
             s:BindingContextResolver.Type="{x:Type module:StartupViewModel}">

    <!-- 起動: システムのロゴと準備の進み具合。スプラッシュと同じ地にする -->
    <!-- 失敗したとき (通信できない、ホール端末でない、テナントの停止) は、しばらくごとに自動でやり直す。縦長の画面なので操作は縦に並べる -->
    <Grid Style="{StaticResource SystemScreenGrid}"
          RowDefinitions="*,Auto,*,Auto">
        <VerticalStackLayout Grid.Row="1"
                             Style="{StaticResource StartupStack}">
            <!-- logo -->
            <Image Style="{StaticResource SystemLogoImage}"
                   Source="system_logo.png" />
            <VerticalStackLayout Style="{StaticResource StartupTitleStack}">
                <Label Style="{StaticResource SystemWordmarkLabel}"
                       Text="TableOrder" />
                <Label Style="{StaticResource StartupAppLabel}"
                       Text="{x:Static strings:AppResources.AppTitle}" />
            </VerticalStackLayout>

            <!-- progress -->
            <Grid Style="{StaticResource StartupProgressGrid}">
                <BoxView Style="{StaticResource StartupProgressTrack}" />
                <BoxView Style="{StaticResource StartupProgressBar}"
                         ScaleX="{Binding Progress}" />
            </Grid>
            <Label Style="{StaticResource StartupStepLabel}"
                   Text="{Binding StepText}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsFailed}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{DynamicResource ErrorColor}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- failure -->
            <VerticalStackLayout Style="{StaticResource StartupActionStack}"
                                 IsVisible="{Binding IsFailed}">
                <Button Style="{StaticResource SystemPrimaryButton}"
                        Command="{Binding RetryCommand}"
                        Text="{x:Static strings:AppResources.StartupRetry}" />
                <Button Style="{StaticResource SystemSecondaryButton}"
                        Command="{Binding SetupCommand}"
                        Text="{x:Static strings:AppResources.StartupSetup}" />
            </VerticalStackLayout>
            <Label Style="{StaticResource StartupHintLabel}"
                   IsVisible="{Binding IsAutoRetry}"
                   Text="{Binding RetryHintText}" />
        </VerticalStackLayout>

        <!-- version -->
        <Label Grid.Row="3"
               Style="{StaticResource SystemFooterLabel}"
               Text="{Binding VersionText}" />
    </Grid>

</ContentView>
