<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TableOrder.KitchenApp</RootNamespace>
    <CodeAnalysisRuleSet>..\..\..\Analyzers.ruleset</CodeAnalysisRuleSet>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <!-- サーバは /kitchen の下で配る (wwwroot/index.html の base と合わせる) -->
    <StaticWebAssetBasePath>kitchen</StaticWebAssetBasePath>
  </PropertyGroup>

  <!-- 日本語の照合と店舗のタイムゾーンを使うので、地域の情報を省かない -->
  <PropertyGroup>
    <InvariantGlobalization>false</InvariantGlobalization>
    <InvariantTimezone>false</InvariantTimezone>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
  </ItemGroup>

</Project>
