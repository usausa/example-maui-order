@page "/account/two-factor"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout

<PageTitle>多要素認証</PageTitle>

<MudPaper Class="account-card pa-8" Outlined="true">
    <MudText Typo="Typo.h5" Class="mb-6">多要素認証</MudText>
    @if (message is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@message</MudAlert>
    }
    @if (recoveryCodes.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">回復コードは再表示できないため、控えて保管してください (各コードは 1 回だけ使用可能)</MudAlert>
        <div class="account-codes">
            @foreach (var recoveryCode in recoveryCodes)
            {
                <code>@recoveryCode</code>
            }
        </div>
    }
    @if (enabled)
    {
        <MudText Class="mb-4">多要素認証は有効です</MudText>
        <EditForm Model="Action!" method="post" OnSubmit="HandleAsync" FormName="enabled">
            <div class="account-actions">
                <button type="submit" name="Action.Action" value="codes" class="account-button account-button-secondary">回復コードを再発行</button>
                <button type="submit" name="Action.Action" value="disable" class="account-button account-button-danger">多要素認証を解除</button>
            </div>
        </EditForm>
    }
    else
    {
        <MudText Class="mb-2">1. 認証アプリに次のセットアップキーを登録</MudText>
        <div class="account-key">@sharedKey</div>
        <details class="account-details">
            <summary>セットアップキーの URI</summary>
            <code class="account-uri">@authenticatorUri</code>
        </details>
        <MudText Class="mt-4 mb-2">2. 認証アプリに表示された 6 桁のコードを入力</MudText>
        <EditForm Model="Code!" method="post" OnValidSubmit="EnableAsync" FormName="enable">
            <DataAnnotationsValidator />
            <div class="account-field">
                <label for="code">コード</label>
                <InputText id="code" class="account-input" autocomplete="one-time-code" inputmode="numeric" @bind-Value="Code!.Code" />
                <ValidationMessage For="() => Code!.Code" class="account-error" />
            </div>
            <button type="submit" class="account-button">有効化</button>
        </EditForm>
    }
    <div class="account-links">
        <a href="@AccountPaths.Account">アカウントに戻る</a>
    </div>
</MudPaper>
