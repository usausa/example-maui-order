@page "/account/sign-in-2fa"
@using Microsoft.AspNetCore.RateLimiting
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@attribute [EnableRateLimiting(RateLimits.SignIn)]
@layout AccountLayout

<PageTitle>認証アプリのコード</PageTitle>

<MudPaper Class="account-card pa-8" Outlined="true">
    <MudText Typo="Typo.h5" Class="mb-2">認証アプリのコード</MudText>
    <MudText Class="mb-6">認証アプリに表示された 6 桁のコードを入力してください</MudText>
    @if (message is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@message</MudAlert>
    }
    <EditForm Model="Code!" method="post" OnValidSubmit="VerifyAsync" FormName="code">
        <DataAnnotationsValidator />
        <div class="account-field">
            <label for="code">コード</label>
            <InputText id="code" class="account-input" autocomplete="one-time-code" inputmode="numeric" @bind-Value="Code!.Code" />
            <ValidationMessage For="() => Code!.Code" class="account-error" />
        </div>
        <button type="submit" class="account-button">サインイン</button>
    </EditForm>
    <details class="account-details">
        <summary>回復コードを使う</summary>
        <EditForm Model="Recovery!" method="post" OnValidSubmit="RecoverAsync" FormName="recovery">
            <DataAnnotationsValidator />
            <div class="account-field">
                <label for="recovery">回復コード</label>
                <InputText id="recovery" class="account-input" autocomplete="off" @bind-Value="Recovery!.Code" />
                <ValidationMessage For="() => Recovery!.Code" class="account-error" />
            </div>
            <button type="submit" class="account-button account-button-secondary">回復コードでサインイン</button>
        </EditForm>
    </details>
    <div class="account-links">
        <a href="@AccountPaths.SignIn">サインインに戻る</a>
    </div>
</MudPaper>
