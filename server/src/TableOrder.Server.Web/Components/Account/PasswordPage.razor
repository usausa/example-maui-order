@page "/account/password"
@attribute [ExcludeFromInteractiveRouting]
@layout AccountLayout

<PageTitle>パスワード</PageTitle>

<MudPaper Class="account-card pa-8" Outlined="true">
    <MudText Typo="Typo.h5" Class="mb-6">パスワードを替える</MudText>
    @if (mustChange)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4">仮のパスワードでサインインしています。使い始める前に、新しいパスワードに替えてください。</MudAlert>
    }
    @foreach (var error in errors)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@error</MudAlert>
    }
    @if (changed)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">パスワードを替えました。</MudAlert>
    }
    else
    {
        <EditForm Model="Input!" method="post" OnValidSubmit="ChangeAsync" FormName="password">
            <DataAnnotationsValidator />
            <div class="account-field">
                <label for="current">今のパスワード</label>
                <InputText id="current" type="password" class="account-input" autocomplete="current-password" @bind-Value="Input!.CurrentPassword" />
                <ValidationMessage For="() => Input!.CurrentPassword" class="account-error" />
            </div>
            <div class="account-field">
                <label for="new">新しいパスワード (12 文字以上)</label>
                <InputText id="new" type="password" class="account-input" autocomplete="new-password" @bind-Value="Input!.NewPassword" />
                <ValidationMessage For="() => Input!.NewPassword" class="account-error" />
            </div>
            <div class="account-field">
                <label for="confirm">新しいパスワード (確かめ)</label>
                <InputText id="confirm" type="password" class="account-input" autocomplete="new-password" @bind-Value="Input!.ConfirmPassword" />
                <ValidationMessage For="() => Input!.ConfirmPassword" class="account-error" />
            </div>
            <button type="submit" class="account-button">替える</button>
        </EditForm>
    }
    @if (!mustChange)
    {
        <div class="account-links">
            <a href="@AccountPaths.Account">アカウントに戻る</a>
        </div>
    }
</MudPaper>
