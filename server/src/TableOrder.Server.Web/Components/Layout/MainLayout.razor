@inherits LayoutComponentBase

<MudThemeProvider Theme="Styles.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2">TableOrder</MudText>
        <MudSpacer />
        @if (Scope.IsInitialized)
        {
            <MudButton Href="@AccountPaths.Account" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.AccountCircle">@Scope.Name (@AdminNames.RoleName(Scope.Role))</MudButton>
            @* サインアウトは Cookie を消すので、画面の回線ではなくフォームの POST で送る *@
            <form action="@AccountPaths.SignOut" method="post">
                <AntiforgeryToken />
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Text" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Logout">サインアウト</MudButton>
            </form>
        }
    </MudAppBar>
    <MudDrawer @bind-Open="drawerOpen" Elevation="2">
        <NavMenu />
    </MudDrawer>
    @* 余白は内側に付ける (MudMainContent の上の余白は上の帯の高さで、pa-4 で上書きすると帯の下に隠れる) *@
    <MudMainContent>
        <div class="pa-4">
            @if (initialized)
            {
                @* 店舗の選択の失敗も画面の失敗として出す (外に置くと、回線ごと終わって選択と入力を失う) *@
                <ErrorBoundary @ref="errorBoundary">
                    <ChildContent>
                        @if (Scope.IsInitialized)
                        {
                            <StoreSelector />
                        }
                        @Body
                    </ChildContent>
                    <ErrorContent>
                        <MudAlert Severity="Severity.Error" Class="mb-4">エラーが発生しました。</MudAlert>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Recover">再試行</MudButton>
                    </ErrorContent>
                </ErrorBoundary>
            }
        </div>
    </MudMainContent>
</MudLayout>
