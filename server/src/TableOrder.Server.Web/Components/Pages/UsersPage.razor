@page "/users"
@attribute [Authorize(Policy = AdminPolicies.TenantAdmin)]

<PageTitle>利用者</PageTitle>

<MudText Typo="Typo.h4">利用者</MudText>

@if (Selection.TenantId is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">テナントを選択してください</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">利用者の追加</MudText>
        <MudGrid Class="mt-2" Spacing="2">
            <MudItem xs="12" sm="3">
                <MudTextField T="string" @bind-Value="addEmail" Label="メールアドレス" InputType="InputType.Email" MaxLength="@AdminUserService.MaxEmailLength" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField T="string" @bind-Value="addName" Label="名前" MaxLength="@AdminUserService.MaxNameLength" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudSelect T="AdminRole" @bind-Value="addRole" Label="役割">
                    @foreach (var role in Roles)
                    {
                        <MudSelectItem T="AdminRole" Value="@role">@AdminNames.RoleName(role)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (addRole == AdminRole.StoreStaff)
            {
                <MudItem xs="12" sm="3">
                    <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="addStoreIds" Label="担当店舗" ToStringFunc="StoreName">
                        @foreach (var store in stores)
                        {
                            <MudSelectItem T="Guid" Value="@store.Id">@StoreName(store.Id)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="1" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="AddAsync">追加</MudButton>
            </MudItem>
        </MudGrid>
        @if (issued is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4">
                @issued.Email の仮パスワード <span class="temporary-password">@issued.Password</span> (再表示できません)
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <div class="d-flex align-center">
            <MudText Typo="Typo.h6">利用者一覧</MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">再読み込み</MudButton>
        </div>
        <MudTable Items="users" Dense="true" Elevation="0" Class="mt-2 nowrap-table">
            <HeaderContent>
                <MudTh>名前</MudTh>
                <MudTh>メールアドレス</MudTh>
                <MudTh>役割</MudTh>
                <MudTh>担当店舗</MudTh>
                <MudTh>多要素認証</MudTh>
                <MudTh>最終サインイン (@TimeZoneName)</MudTh>
                <MudTh>状態</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.User.Name</MudTd>
                <MudTd>@context.User.Email</MudTd>
                <MudTd>@AdminNames.RoleName(context.User.Role)</MudTd>
                <MudTd>@StoresText(context)</MudTd>
                <MudTd>@(context.User.TwoFactorEnabled ? "有効" : "--")</MudTd>
                <MudTd>@(context.User.LastSignInAt is { } signedIn ? FormatTime(signedIn) : "--")</MudTd>
                <MudTd>@StatusText(context.User)</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="() => Edit(context)">変更</MudButton>
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (context.User.Id == editing?.User.Id)
                {
                    <MudTr>
                        <td colspan="8" class="pa-4">
                            <MudGrid Class="mt-2" Spacing="2">
                                <MudItem xs="12" sm="4">
                                    <MudTextField T="string" @bind-Value="editName" Label="名前" MaxLength="@AdminUserService.MaxNameLength" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudSelect T="AdminRole" @bind-Value="editRole" Label="役割" Disabled="IsSelf(context)">
                                        @foreach (var role in Roles)
                                        {
                                            <MudSelectItem T="AdminRole" Value="@role">@AdminNames.RoleName(role)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                @if (editRole == AdminRole.StoreStaff)
                                {
                                    <MudItem xs="12" sm="5">
                                        <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="editStoreIds" Label="担当店舗" ToStringFunc="StoreName">
                                            @foreach (var store in stores)
                                            {
                                                <MudSelectItem T="Guid" Value="@store.Id">@StoreName(store.Id)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                            </MudGrid>
                            <div class="d-flex gap-2 mt-4 flex-wrap">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">保存</MudButton>
                                <MudButton OnClick="CancelEdit">キャンセル</MudButton>
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" OnClick="ResetPasswordAsync">仮パスワードを再発行</MudButton>
                                @if (context.User.TwoFactorEnabled)
                                {
                                    <MudButton Variant="Variant.Outlined" OnClick="ResetTwoFactorAsync">多要素認証を解除</MudButton>
                                }
                                @if (context.User.IsActive)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="IsSelf(context)" OnClick="() => SetActiveAsync(false)">停止</MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" OnClick="() => SetActiveAsync(true)">再開</MudButton>
                                }
                            </div>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
            <NoRecordsContent>
                <MudText>利用者はいません</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
