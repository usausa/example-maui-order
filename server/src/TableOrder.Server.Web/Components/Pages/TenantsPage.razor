@page "/tenants"
@attribute [Authorize(Policy = AdminPolicies.Operator)]

<PageTitle>テナント</PageTitle>

<MudText Typo="Typo.h4">テナント</MudText>

<MudPaper Class="pa-4 mt-4">
    <MudText Typo="Typo.h6">テナントの登録</MudText>
    <MudGrid Class="mt-2" Spacing="2">
        <MudItem xs="12" sm="2">
            <MudTextField T="string" @bind-Value="addCode" Label="コード" MaxLength="@TenantService.MaxCodeLength" HelperText="英小文字・数字・ハイフン" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudTextField T="string" @bind-Value="addName" Label="会社名" MaxLength="@TenantService.MaxNameLength" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField T="string" @bind-Value="addBrandJa" Label="チェーン名 (日本語)" MaxLength="@Length.BrandName" />
        </MudItem>
        <MudItem xs="12" sm="2">
            <MudTextField T="string" @bind-Value="addBrandEn" Label="チェーン名 (英語)" MaxLength="@Length.BrandName" />
        </MudItem>
        <MudItem xs="12" sm="2" Class="d-flex align-center">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="AddAsync">登録</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Class="pa-4 mt-4">
    <div class="d-flex align-center">
        <MudText Typo="Typo.h6">テナント一覧</MudText>
        <MudSpacer />
        <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">再読み込み</MudButton>
    </div>
    <MudTable Items="tenants" Dense="true" Elevation="0" Class="mt-2 nowrap-table">
        <HeaderContent>
            <MudTh>コード</MudTh>
            <MudTh>会社名</MudTh>
            <MudTh>チェーン名</MudTh>
            <MudTh>店舗数</MudTh>
            <MudTh>状態</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>@context.Code</MudTd>
            <MudTd>@context.Name</MudTd>
            <MudTd>@context.BrandName.Ja</MudTd>
            <MudTd>@AdminNames.FormatCount(context.StoreCount)</MudTd>
            <MudTd>@AdminNames.TenantStatusName(context.Status)</MudTd>
            <MudTd>
                @if (context.Status == TenantStatus.Active)
                {
                    <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => SetSuspendedAsync(context, true)">停止</MudButton>
                }
                else if (context.Status == TenantStatus.Suspended)
                {
                    <MudButton Size="Size.Small" OnClick="() => SetSuspendedAsync(context, false)">再開</MudButton>
                }
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>
