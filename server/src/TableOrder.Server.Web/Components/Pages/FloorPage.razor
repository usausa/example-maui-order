@page "/floor"
@using TableOrder.Contract.Stores

<PageTitle>店内状況</PageTitle>

<div class="d-flex align-center">
    <MudText Typo="Typo.h4">店内状況</MudText>
    <MudSpacer />
    @if (loadedAt is { } loaded)
    {
        <MudText Typo="Typo.body2" Class="mr-2">最終更新 @FormatTime(loaded) (時刻は @timeZone)</MudText>
    }
    <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">再読み込み</MudButton>
</div>

@if (Selection.StoreId is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">テナントと店舗を選択してください</MudAlert>
}
else
{
    <MudGrid Class="mt-2" Spacing="3">
        <MudItem xs="12" lg="8">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">テーブル</MudText>
                <MudTable Items="tables" Dense="true" Hover="true" Elevation="0" Class="mt-2 nowrap-table floor-tables" T="TableListResponseItem" OnRowClick="SelectAsync" RowClassFunc="@((table, _) => RowClass(table))">
                    <HeaderContent>
                        <MudTh>テーブル</MudTh>
                        <MudTh>席数</MudTh>
                        <MudTh>状態</MudTh>
                        <MudTh>人数</MudTh>
                        <MudTh>経過</MudTh>
                        <MudTh>未提供</MudTh>
                        <MudTh>呼び出し</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Capacity</MudTd>
                        <MudTd>@StatusText(context.Visit)</MudTd>
                        <MudTd>@(context.Visit is { } visit ? GuestText(visit) : "--")</MudTd>
                        <MudTd>@(context.Visit is { } opened ? ElapsedText(opened.OpenedAt) : "--")</MudTd>
                        <MudTd>@CountText(context.Visit?.UnservedCount)</MudTd>
                        <MudTd>@CountText(context.Visit?.OpenCallCount)</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText>テーブルはありません</MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" lg="4">
            <MudPaper Class="pa-4">
                @if (SelectedTable is not { } selected)
                {
                    <MudText Typo="Typo.h6">来店</MudText>
                    <MudText Class="mt-2">テーブルを選択してください</MudText>
                }
                else if (selected.Visit is not { } visit)
                {
                    <MudText Typo="Typo.h6">テーブル @selected.Name (空き、@selected.Capacity 席)</MudText>
                    <MudGrid Class="mt-2" Spacing="2">
                        <MudItem xs="6">
                            <MudNumericField T="int" @bind-Value="guideAdults" Label="大人" Min="0" Max="@Length.MaxGuests" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudNumericField T="int" @bind-Value="guideChildren" Label="子ども (小学生以下)" Min="0" Max="@Length.MaxGuests" />
                        </MudItem>
                    </MudGrid>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="() => OpenAsync(selected)">来店登録</MudButton>
                }
                else
                {
                    <MudText Typo="Typo.h6">テーブル @selected.Name の来店 (@StatusText(visit))</MudText>
                    <MudText Typo="Typo.body2" Class="mt-1">@GuestText(visit)、@FormatTime(visit.OpenedAt) 来店、注文額 @AdminNames.FormatAmount(orders.Sum(static x => x.Amount)) (税込)</MudText>
                    <div class="d-flex gap-2 mt-2">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="() => CloseAsync(selected)">レジ会計済み</MudButton>
                        @if (CanCancel(visit))
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="() => CancelAsync(selected)">来店取消</MudButton>
                        }
                    </div>
                    @if (orders.Count == 0)
                    {
                        <MudText Class="mt-4">注文はありません</MudText>
                    }
                    @foreach (var order in orders)
                    {
                        <MudText Typo="Typo.subtitle2" Class="mt-4">注文 @order.OrderNo (@FormatTime(order.OrderedAt)、@AdminNames.OrderSourceName(order.Source)) @AdminNames.FormatAmount(order.Amount)</MudText>
                        <MudSimpleTable Dense="true" Elevation="0" Class="mt-1">
                            <tbody>
                                @foreach (var line in order.Lines)
                                {
                                    <tr class="@(line.Status == OrderLineStatus.Cancelled ? "line-cancelled" : null)">
                                        <td>@LineText(line) × @line.Quantity</td>
                                        <td class="floor-nowrap">@AdminNames.OrderLineStatusName(line.Status)</td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    }
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">呼び出し</MudText>
                @if (calls.Count == 0)
                {
                    <MudText Class="mt-2">未完了の呼び出しはありません</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="mt-2 floor-side">
                        <tbody>
                            @foreach (var call in calls)
                            {
                                <tr>
                                    <td class="floor-nowrap">@FormatTime(call.Call.CreatedAt)</td>
                                    <td class="floor-nowrap">テーブル @call.Call.TableName</td>
                                    <td>@call.ReasonName.Ja</td>
                                    <td class="floor-nowrap">@AdminNames.CallStatusName(call.Call.Status)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">品切れ</MudText>
                @if (stock.Count == 0)
                {
                    <MudText Class="mt-2">品切れ・残数のある商品はありません</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="mt-2 floor-side">
                        <tbody>
                            @foreach (var item in stock)
                            {
                                <tr>
                                    <td>@StockName(item)</td>
                                    <td class="floor-nowrap @(item.Stock.Status == StockStatus.SoldOut ? "mud-error-text" : "mud-warning-text")">@StockText(item.Stock)</td>
                                    <td class="floor-nowrap">@FormatTime(item.Stock.UpdatedAt)</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.h6">通知履歴</MudText>
                @if (events.Count == 0)
                {
                    <MudText Class="mt-2">通知はありません</MudText>
                }
                else
                {
                    <MudSimpleTable Dense="true" Elevation="0" Class="mt-2 floor-side">
                        <tbody>
                            @foreach (var item in events)
                            {
                                <tr>
                                    <td class="floor-nowrap">@FormatTime(item.OccurredAt)</td>
                                    <td>@EventName(item.Type)</td>
                                    <td class="floor-nowrap mud-text-secondary">@item.Seq</td>
                                </tr>
                            }
                        </tbody>
                    </MudSimpleTable>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
}
