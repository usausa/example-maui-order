@page "/stores"
@attribute [Authorize(Policy = AdminPolicies.TenantAdmin)]

<PageTitle>店舗</PageTitle>

<MudText Typo="Typo.h4">店舗</MudText>

@if (Selection.TenantId is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">テナントを選択してください</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">店舗の追加</MudText>
        <StoreFields Form="addForm" Stores="stores" IsNew="true" />
        <div class="d-flex mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync">追加</MudButton>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <div class="d-flex align-center">
            <MudText Typo="Typo.h6">店舗一覧</MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">再読み込み</MudButton>
        </div>
        <MudTable Items="stores" Dense="true" Elevation="0" Class="mt-2 nowrap-table">
            <HeaderContent>
                <MudTh>店舗コード</MudTh>
                <MudTh>名前</MudTh>
                <MudTh>営業時間</MudTh>
                <MudTh>ラストオーダー</MudTh>
                <MudTh>注文の上限</MudTh>
                <MudTh>状態</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.Name.Ja</MudTd>
                <MudTd>@context.OpenTime - @context.CloseTime</MudTd>
                <MudTd>@(context.LastOrderTime ?? "--")</MudTd>
                <MudTd>@context.MaxQuantityPerLine 個 / @context.MaxLinesPerOrder 明細</MudTd>
                <MudTd>@(context.IsActive ? "利用可能" : "利用停止中")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="() => Edit(context)">変更</MudButton>
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (context.Id == editing?.Id)
                {
                    <MudTr>
                        <td colspan="7" class="pa-4">
                            <StoreFields Form="editForm" Stores="stores" IsNew="false" />
                            <div class="d-flex gap-2 mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">保存</MudButton>
                                <MudButton OnClick="CancelEdit">キャンセル</MudButton>
                                <MudSpacer />
                                @if (context.IsActive)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => SetActiveAsync(false)">利用停止</MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" OnClick="() => SetActiveAsync(true)">利用再開</MudButton>
                                }
                            </div>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
            <NoRecordsContent>
                <MudText>店舗はありません</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
