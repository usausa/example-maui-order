@page "/tables"

<PageTitle>テーブル</PageTitle>

<MudText Typo="Typo.h4">テーブル</MudText>

@if (Selection.StoreId is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">テナントと店舗を選択してください</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">テーブルの追加</MudText>
        <MudGrid Class="mt-2" Spacing="2">
            <MudItem xs="12" sm="3">
                <MudTextField T="string" @bind-Value="addName" Label="名前" MaxLength="@TableSetupService.MaxNameLength" />
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField T="string" @bind-Value="addArea" Label="エリア" MaxLength="@TableSetupService.MaxAreaLength" HelperText="窓側、2F など (空欄可)" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudNumericField T="int" @bind-Value="addCapacity" Label="席数" Min="1" Max="@TableSetupService.MaxCapacity" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAsync">追加</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <div class="d-flex align-center">
            <MudText Typo="Typo.h6">テーブル一覧</MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">再読み込み</MudButton>
        </div>
        <MudTable Items="tables" Dense="true" Elevation="0" Class="mt-2 nowrap-table">
            <HeaderContent>
                <MudTh>表示順</MudTh>
                <MudTh>名前</MudTh>
                <MudTh>エリア</MudTh>
                <MudTh>席数</MudTh>
                <MudTh>端末</MudTh>
                <MudTh>状態</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="IsFirst(context)" OnClick="() => MoveAsync(context, -1)" aria-label="上へ" />
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="IsLast(context)" OnClick="() => MoveAsync(context, 1)" aria-label="下へ" />
                </MudTd>
                <MudTd>@context.Name</MudTd>
                <MudTd>@(context.Area ?? "--")</MudTd>
                <MudTd>@AdminNames.FormatCount(context.Capacity)</MudTd>
                <MudTd>@(context.DeviceCount > 0 ? $"{AdminNames.FormatCount(context.DeviceCount)} 台" : "--")</MudTd>
                <MudTd>@StatusText(context)</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" OnClick="() => Edit(context)">変更</MudButton>
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (context.Id == editing?.Id)
                {
                    <MudTr>
                        <td colspan="7" class="pa-4">
                            <MudGrid Spacing="2">
                                <MudItem xs="12" sm="3">
                                    <MudTextField T="string" @bind-Value="editName" Label="名前" MaxLength="@TableSetupService.MaxNameLength" />
                                </MudItem>
                                <MudItem xs="12" sm="3">
                                    <MudTextField T="string" @bind-Value="editArea" Label="エリア" MaxLength="@TableSetupService.MaxAreaLength" />
                                </MudItem>
                                <MudItem xs="12" sm="2">
                                    <MudNumericField T="int" @bind-Value="editCapacity" Label="席数" Min="1" Max="@TableSetupService.MaxCapacity" />
                                </MudItem>
                            </MudGrid>
                            <div class="d-flex gap-2 mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">保存</MudButton>
                                <MudButton OnClick="CancelEdit">キャンセル</MudButton>
                                <MudSpacer />
                                @if (context.IsActive)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="() => SetActiveAsync(false)">利用停止</MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" OnClick="() => SetActiveAsync(true)">利用再開</MudButton>
                                }
                            </div>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
            <NoRecordsContent>
                <MudText>テーブルはありません</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
