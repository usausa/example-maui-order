@page "/devices"

<PageTitle>端末</PageTitle>

<MudText Typo="Typo.h4">端末</MudText>

@if (Selection.StoreId is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">テナントと店舗を選択してください</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">ペアリングコードの発行</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">有効期限 10 分、1 台のみ</MudText>
        <MudGrid Class="mt-2" Spacing="2">
            <MudItem xs="12" sm="3">
                <MudSelect T="DeviceKind" Value="issueKind" ValueChanged="SelectIssueKind" Label="端末の種類">
                    @foreach (var kind in Kinds)
                    {
                        <MudSelectItem T="DeviceKind" Value="@kind">@AdminNames.DeviceKindName(kind)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @if (issueKind == DeviceKind.Table)
            {
                <MudItem xs="12" sm="3">
                    <MudSelect T="Guid?" @bind-Value="issueTableId" Label="テーブル" Clearable="true">
                        @foreach (var table in tables)
                        {
                            <MudSelectItem T="Guid?" Value="@table.Id">@table.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            @if (issueKind == DeviceKind.Kitchen)
            {
                <MudItem xs="12" sm="5">
                    <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="issueStationIds" Label="持ち場" ToStringFunc="StationName">
                        @foreach (var station in stations)
                        {
                            <MudSelectItem T="Guid" Value="@station.Id">@station.Name</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="IssueAsync">発行</MudButton>
            </MudItem>
        </MudGrid>
        @if (issued is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4">
                ペアリングコード <span class="pairing-code">@issued.Code</span> (@FormatTime(issued.ExpiresAt) まで有効)
            </MudAlert>
        }
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">登録トークンの発行 (EMM)</MudText>
        <MudGrid Class="mt-2" Spacing="2">
            <MudItem xs="12" sm="3">
                <MudSelect T="DeviceKind" @bind-Value="tokenKind" Label="端末の種類">
                    @foreach (var kind in Kinds)
                    {
                        <MudSelectItem T="DeviceKind" Value="@kind">@AdminNames.DeviceKindName(kind)</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudNumericField T="int" @bind-Value="tokenMaxUses" Label="上限台数" Min="1" Max="@DeviceEnrollmentService.MaxTokenUses" />
            </MudItem>
            <MudItem xs="6" sm="2">
                <MudNumericField T="int" @bind-Value="tokenDays" Label="有効期間 (日)" Min="1" Max="@DeviceEnrollmentService.MaxTokenDays" />
            </MudItem>
            <MudItem xs="12" sm="2" Class="d-flex align-center">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="Busy" OnClick="IssueTokenAsync">発行</MudButton>
            </MudItem>
        </MudGrid>
        @if (issuedToken is not null)
        {
            <MudAlert Severity="Severity.Success" Class="mt-4">
                <div>管理対象の構成の値 (@FormatTime(issuedToken.ExpiresAt) まで有効、トークンは再表示できません)</div>
                <table class="managed-config mt-2">
                    <tr>
                        <th>apiEndPoint</th>
                        <td>@ApiEndPoint</td>
                    </tr>
                    <tr>
                        <th>enrollmentToken</th>
                        <td>@issuedToken.Token</td>
                    </tr>
                </table>
            </MudAlert>
        }
        <MudTable Items="tokens" Dense="true" Elevation="0" Class="mt-4 nowrap-table">
            <HeaderContent>
                <MudTh>種類</MudTh>
                <MudTh>登録台数</MudTh>
                <MudTh>有効期限 (@timeZone)</MudTh>
                <MudTh>発行日時 (@timeZone)</MudTh>
                <MudTh>状態</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@AdminNames.DeviceKindName(context.Kind)</MudTd>
                <MudTd>@AdminNames.FormatCount(context.UsedCount) / @AdminNames.FormatCount(context.MaxUses)</MudTd>
                <MudTd>@FormatTime(context.ExpiresAt)</MudTd>
                <MudTd>@FormatTime(context.CreatedAt)</MudTd>
                <MudTd>@TokenStatusText(context)</MudTd>
                <MudTd>
                    @if (IsUsable(context))
                    {
                        <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => RevokeTokenAsync(context)">取消</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText>発行した登録トークンはありません</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <div class="d-flex align-center">
            <MudText Typo="Typo.h6">登録済みの端末</MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">再読み込み</MudButton>
        </div>
        <MudTable Items="devices" Dense="true" Elevation="0" Class="mt-2 nowrap-table">
            <HeaderContent>
                <MudTh>名前</MudTh>
                <MudTh>種類</MudTh>
                <MudTh>割り当て</MudTh>
                <MudTh>最終通信 (@timeZone)</MudTh>
                <MudTh>電池残量</MudTh>
                <MudTh>バージョン</MudTh>
                <MudTh>状態</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Device.Name</MudTd>
                <MudTd>@AdminNames.DeviceKindName(context.Device.Kind)</MudTd>
                <MudTd>
                    @if (context.IsWaitingPlacement)
                    {
                        <span class="mud-warning-text">割り当て待ち</span>
                    }
                    else
                    {
                        @PlacementText(context)
                    }
                </MudTd>
                <MudTd>@(context.Device.LastSeenAt is { } seen ? FormatLastSeen(seen) : "--")</MudTd>
                <MudTd>@BatteryText(context.Device)</MudTd>
                <MudTd>@(context.Device.AppVersion ?? "--")</MudTd>
                <MudTd>@(context.Device.IsActive ? "有効" : "無効")</MudTd>
                <MudTd>
                    @if (context.Device.IsActive)
                    {
                        <MudButton Size="Size.Small" OnClick="() => Edit(context)">@(context.IsWaitingPlacement ? "割り当て" : "変更")</MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if (context.Device.Id == editing?.Device.Id)
                {
                    <MudTr>
                        <td colspan="8" class="pa-4">
                            <MudGrid Class="mt-2" Spacing="2">
                                <MudItem xs="12" sm="4">
                                    <MudTextField T="string" @bind-Value="editName" Label="名前" MaxLength="@Length.DeviceName" />
                                </MudItem>
                                @if (context.Device.Kind == DeviceKind.Table)
                                {
                                    <MudItem xs="12" sm="3">
                                        <MudSelect T="Guid?" @bind-Value="editTableId" Label="テーブル" Clearable="true">
                                            @foreach (var table in tables)
                                            {
                                                <MudSelectItem T="Guid?" Value="@table.Id">@table.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                                @if (context.Device.Kind == DeviceKind.Kitchen)
                                {
                                    <MudItem xs="12" sm="5">
                                        <MudSelect T="Guid" MultiSelection="true" @bind-SelectedValues="editStationIds" Label="持ち場" ToStringFunc="StationName">
                                            @foreach (var station in stations)
                                            {
                                                <MudSelectItem T="Guid" Value="@station.Id">@station.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                }
                            </MudGrid>
                            <div class="d-flex gap-2 mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">保存</MudButton>
                                <MudButton OnClick="CancelEdit">キャンセル</MudButton>
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RevokeAsync">無効化</MudButton>
                            </div>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
            <NoRecordsContent>
                <MudText>登録済みの端末はありません</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
