@page "/store-settings"

<PageTitle>店舗設定</PageTitle>

<MudText Typo="Typo.h4">店舗設定</MudText>

@if (Selection.StoreId is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">テナントと店舗を選択してください</MudAlert>
}
else if (version is not null)
{
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">案内方法</MudText>
        <MudSelect T="VisitOpening" @bind-Value="visitOpening" Label="案内方法" Class="mt-2 opening-field">
            <MudSelectItem T="VisitOpening" Value="VisitOpening.Hall">スタッフ (ホール端末で案内)</MudSelectItem>
            <MudSelectItem T="VisitOpening" Value="VisitOpening.Reception">受付機 (お客様が人数を入力し、空席を自動で案内)</MudSelectItem>
            <MudSelectItem T="VisitOpening" Value="VisitOpening.Table">セルフ着席 (お客様が空席に着き、テーブル端末で開始)</MudSelectItem>
        </MudSelect>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">機能</MudText>
        <MudGrid Class="mt-2" Spacing="2">
            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="registerCheckout" Label="お会計にレジ払いを表示" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSwitch T="bool" @bind-Value="splitPayment" Label="割り勘 (1 人分ずつの支払い)" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="lastOrderNoticeMinutes" Label="ラストオーダーのお知らせ (何分前、0 で無効)" Min="0" Max="180" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="finishSeconds" Label="お礼の画面の表示時間 (秒)" Min="5" Max="300" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="kitchenAlertMinutes" Label="キッチンの遅れの警告 (分、0 で無効)" Min="0" Max="120" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField T="int" @bind-Value="daypartGraceMinutes" Label="時間帯の終了後の注文の猶予 (分、0 で無効)" Min="0" Max="10" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">言語と支払方法</MudText>
        <div class="d-flex flex-wrap gap-4 mt-2">
            <MudCheckBox T="bool" @bind-Value="japanese" Label="日本語" />
            <MudCheckBox T="bool" @bind-Value="english" Label="英語" />
        </div>
        <div class="d-flex flex-wrap gap-4">
            <MudCheckBox T="bool" @bind-Value="qrCode" Label="QR コード決済" />
            <MudCheckBox T="bool" @bind-Value="creditCard" Label="クレジットカード" />
        </div>
        <MudSwitch T="bool" @bind-Value="electronicReceipt" Label="電子レシート (テーブル会計のお礼の画面に QR を表示)" Color="Color.Primary" Class="mt-2" />
        <MudGrid Class="mt-1" Spacing="2">
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="issuerName" Label="事業者名" MaxLength="@Length.IssuerName" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" @bind-Value="invoiceRegistrationNumber" Label="登録番号" HelperText="T と 13 桁の数字 (空欄可)" MaxLength="@Length.InvoiceRegistrationNumber" />
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">呼び出しの用件</MudText>
        <div class="d-flex flex-wrap gap-4 mt-2">
            @foreach (var reason in reasons)
            {
                <MudCheckBox T="bool" @bind-Value="reason.IsActive" Label="@reason.Name" />
            }
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">スタッフ PIN</MudText>
        <MudText Typo="Typo.body2" Class="mt-1">変更するときだけ入力 (@Length.StaffPinDigits 桁の数字)</MudText>
        <MudTextField T="string" @bind-Value="newPin" Label="新しい PIN" InputType="InputType.Password" MaxLength="@Length.StaffPinDigits" Class="mt-2 pin-field" />
    </MudPaper>

    <div class="d-flex gap-2 mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync">保存</MudButton>
        <MudButton OnClick="LoadAsync">再読み込み</MudButton>
    </div>
}
