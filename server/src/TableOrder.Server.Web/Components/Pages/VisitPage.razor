@page "/visits"

<PageTitle>案内</PageTitle>

<MudText Typo="Typo.h4">案内</MudText>
<MudText Class="mt-2">テーブルの来店を開く・閉じる (ホール端末ができるまでの仮の画面)</MudText>

@if (Selection.StoreId is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">テナントと店舗を選んでください。</MudAlert>
}
else
{
    <MudPaper Class="pa-4 mt-4">
        <div class="d-flex align-center">
            <MudText Typo="Typo.h6">テーブル</MudText>
            <MudSpacer />
            <MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAsync">読み直す</MudButton>
        </div>
        <MudTable Items="tables" Dense="true" Elevation="0" Class="mt-2 nowrap-table">
            <HeaderContent>
                <MudTh>テーブル</MudTh>
                <MudTh>席</MudTh>
                <MudTh>状態</MudTh>
                <MudTh>人数</MudTh>
                <MudTh>開いた時刻</MudTh>
                <MudTh>まだ出していない品</MudTh>
                <MudTh>呼び出し</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.Capacity</MudTd>
                <MudTd>@StatusText(context.Visit)</MudTd>
                <MudTd>@(context.Visit is { } visit ? GuestText(visit) : "--")</MudTd>
                <MudTd>@(context.Visit is { } opened ? FormatTime(opened.OpenedAt) : "--")</MudTd>
                <MudTd>@CountText(context.Visit?.UnservedCount)</MudTd>
                <MudTd>@CountText(context.Visit?.OpenCallCount)</MudTd>
                <MudTd>
                    @if (context.Visit is null)
                    {
                        <MudButton Size="Size.Small" OnClick="() => Guide(context)">案内する</MudButton>
                    }
                    else
                    {
                        <MudButton Size="Size.Small" OnClick="() => CloseAsync(context)">閉じる</MudButton>
                        @if (context.Visit.Status == VisitStatus.Open)
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" OnClick="() => CancelAsync(context)">取りやめ</MudButton>
                        }
                    }
                </MudTd>
            </RowTemplate>
            <ChildRowContent>
                @if ((context.Id == guidingTableId) && (context.Visit is null))
                {
                    <MudTr>
                        <td colspan="8" class="pa-4">
                            <MudText Typo="Typo.body2">人数を入れて来店を開くと、テーブル端末は待受から注文の画面になります。</MudText>
                            <MudGrid Class="mt-2" Spacing="2">
                                <MudItem xs="6" sm="2">
                                    <MudNumericField T="int" @bind-Value="guideAdults" Label="大人" Min="0" Max="@Length.MaxGuests" />
                                </MudItem>
                                <MudItem xs="6" sm="2">
                                    <MudNumericField T="int" @bind-Value="guideChildren" Label="子ども (小学生以下)" Min="0" Max="@Length.MaxGuests" />
                                </MudItem>
                            </MudGrid>
                            <div class="d-flex gap-2 mt-4">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="() => OpenAsync(context)">来店を開く</MudButton>
                                <MudButton OnClick="CancelGuide">やめる</MudButton>
                            </div>
                        </td>
                    </MudTr>
                }
            </ChildRowContent>
            <NoRecordsContent>
                <MudText>テーブルはありません。</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudPaper>
}
