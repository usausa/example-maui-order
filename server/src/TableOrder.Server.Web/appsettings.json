{
  "AllowedHosts": "*",

  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:8080",
        "Protocols": "Http1"
      }
    }
  },

  "ConnectionStrings": {
    "Default": "Data Source=data.db;Pooling=True;Foreign Keys=True"
  },

  "Database": {
    "SampleData": false
  },

  "Image": {
    "Directory": "images"
  },

  "Admin": {
    "InitialOperatorEmail": "",
    "InitialOperatorPassword": ""
  },

  "Token": {
    "Issuer": "tableorder",
    "Audience": "tableorder-api",
    "AccessTokenMinutes": 30,
    "AssertionMaxMinutes": 5,
    "RevocationSweepSeconds": 5,
    "SigningKey": ""
  },

  "RateLimit": {
    "PairingPerMinute": 10,
    "SignInPerMinute": 10
  },

  "Event": {
    "SweepSeconds": 2
  },

  "Cleanup": {
    "IntervalMinutes": 60,
    "VisitRetentionDays": 90,
    "VisitBatchSize": 200,
    "MenuPublicationsKept": 10
  },

  "Simulation": {
    "Enabled": false,
    "IntervalSeconds": 1,
    "CookingSeconds": 15,
    "ReadySeconds": 45,
    "ServedSeconds": 90,
    "AcknowledgeSeconds": 10,
    "CallDoneSeconds": 60,
    "PaymentSeconds": 5
  },

  "Compression": {
    "Response": true,
    "Request": true
  },

  "Csp": {
    "ReportOnly": false
  },

  "Log": {
    "HttpLog": false,
    "HttpDump": false,
    "HttpDumpLimit": 4096
  },

  "Telemetry": {
    "LongExecutionThreshold": 5000
  },

  "Serilog": {
    "Using": [
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Sinks.Console"
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.HttpLogging": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:HH:mm:ss.fff} {Level:u4} [{SourceContext}] [{ThreadId}] {TraceId} {TenantId} {StoreId} {Subject} {RequestPath} - {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
