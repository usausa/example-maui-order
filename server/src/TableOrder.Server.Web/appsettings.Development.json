{
  "Database": {
    "SampleData": true
  },

  "Csp": {
    "ReportOnly": true
  },

  "Log": {
    "HttpLog": true,
    "HttpDump": true
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error"
      }
    }
  }
}
