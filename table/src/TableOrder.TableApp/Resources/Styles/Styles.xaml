<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:behaviors="clr-namespace:TableOrder.Terminal.Behaviors;assembly=TableOrder.Terminal"
                    xmlns:controls="clr-namespace:TableOrder.TableApp.Controls"
                    xmlns:fonts="clr-namespace:Fonts">

    <!-- 形は角丸・影・グラデーションを使わず、四角い面と罫線と色の面で組む。色は Colors.xaml の役割の名前だけを使う -->
    <!-- チェーンの設定で替える色 (Brand・Neutral・Status) は DynamicResource で引く (スタイルはアプリの起動で作り、色は起動の画面で店舗の設定を読んでから替える) -->

    <!-- ================================================================================ -->
    <!-- Header -->
    <!-- ================================================================================ -->

    <Style x:Key="HeaderGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="BrandMarkBorder"
           TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <!-- ロゴは地の色を含む正方形の画像なので、印の面いっぱいに出す -->
    <Style x:Key="BrandLogoImage"
           TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
    </Style>

    <!-- ロゴがないときの印 (名前の頭の文字) -->
    <Style x:Key="BrandInitialLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
    </Style>

    <Style x:Key="BrandLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="HeaderItemStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Spacing" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="HeaderCaptionLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="HeaderValueLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="HeaderButton"
           TargetType="Button">
        <Setter Property="MinimumWidthRequest" Value="200" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PanelTitleGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="PanelTitleLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="PanelCaptionLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Category -->
    <!-- ================================================================================ -->

    <!-- タブは区切り線で並べた四角い枠にし、選択中は主色の面で示す (選択は DataTrigger で替える) -->

    <Style x:Key="CategoryBarScroll"
           TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <!-- 区切り線の色を間隔から見せる。最後のタブの右にも区切り線を出し、余りは面の色のままにする -->
    <Style x:Key="CategoryBarStack"
           TargetType="HorizontalStackLayout">
        <Setter Property="Padding" Value="0,0,1,0" />
        <Setter Property="Spacing" Value="1" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="{DynamicResource OutlineColor}" />
    </Style>

    <Style x:Key="CategoryTabBorder"
           TargetType="Border">
        <Setter Property="MinimumWidthRequest" Value="144" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="CategoryTabLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- タブが続いている向きの端に重ねる送りのボタン (押すとその向きへ送る)。タブとは罫線で分ける -->
    <Style x:Key="CategoryPagerGrid"
           TargetType="Grid">
        <Setter Property="WidthRequest" Value="65" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="CategoryPagerLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Menu -->
    <!-- ================================================================================ -->

    <!-- カードは 4 列で、縦に 3 段を見せる。料理の写真を主役にし、文字は 2 行の高さにまとめ、+ は写真の右下に重ねる -->
    <!-- 3 段がタブと下部の操作の帯の間に収まるように、カードの高さを 208 (絵 148、文字 60)、間隔を 8 にしている -->

    <!-- カードの間隔の半分が端のカードの外側にも入るので、左右の余白はカードの間隔と同じくらいになる -->
    <Style x:Key="MenuCollectionView"
           TargetType="CollectionView">
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <!-- 見出しと末尾にもカードの間隔の半分ずつが入るので、高さ 0 の行を置くだけで上下の余白がカードの間隔と揃う -->
    <Style x:Key="MenuGapBoxView"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="0" />
    </Style>

    <Style x:Key="MenuCardBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="MenuCardImageGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="148" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
    </Style>

    <Style x:Key="MenuCardImage"
           TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
    </Style>

    <!-- 写真を保存していない間の代わり (面の色の上に、チェーンのロゴか記号) -->
    <Style x:Key="PhotoPlaceholderImage"
           TargetType="Image">
        <Setter Property="WidthRequest" Value="80" />
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Aspect" Value="AspectFit" />
    </Style>

    <Style x:Key="PhotoPlaceholderLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="TextColor" Value="{DynamicResource OutlineColor}" />
    </Style>

    <Style x:Key="MenuBadgeBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
    </Style>

    <Style x:Key="MenuBadgeLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
    </Style>

    <!-- 売り切れは絵に幕をかけて文字を重ねる -->
    <Style x:Key="SoldOutGrid"
           TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{DynamicResource ScrimColor}" />
    </Style>

    <Style x:Key="SoldOutLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnScrimColor}" />
    </Style>

    <!-- 文字は 2 行の高さで揃える。多くの名前は 1 行に収まり、2 行になっても価格を最後の行の右に置く -->
    <Style x:Key="MenuCardTextGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="60" />
        <Setter Property="Padding" Value="12,9,12,3" />
    </Style>

    <!-- 行の高さを固定して、英字と和文で 2 行目の位置を同じにする (価格をそこにそろえる) -->
    <Style x:Key="MenuCardNameLabel"
           TargetType="Label">
        <Setter Property="behaviors:LabelOption.FixedLineHeight" Value="24" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- 名前の後ろで価格の幅を確保する文字 (見える価格と同じ大きさにし、面と同じ色で見せない) -->
    <!-- 名前と同じ大きさにして、この文字が 1 行目に入っても行の高さが変わらないようにする (名前の位置をカードの間で揃える) -->
    <Style x:Key="MenuCardPriceSpaceSpan"
           TargetType="Span">
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <!-- 名前の 2 行目の位置 (1 行の高さの下) に置く。名前と同じ行の組み方 (行の高さとフォントの余白) にして、文字の位置を 2 行目とそろえる -->
    <!-- 3 行に及ぶ長い名前は 2 行目の末尾が価格の下に入るので、価格の左右を面の色で塗って重なりを隠す -->
    <Style x:Key="MenuCardPriceLabel"
           TargetType="Label">
        <Setter Property="behaviors:LabelOption.FixedLineHeight" Value="24" />
        <Setter Property="Margin" Value="0,24,0,0" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="MenuCardAddButton"
           TargetType="Button">
        <Setter Property="WidthRequest" Value="64" />
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="End" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainerColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnPrimaryContainerColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
                            <Setter Property="TextColor" Value="{DynamicResource OnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Action -->
    <!-- ================================================================================ -->

    <!-- 下部の操作は区切り線で並べた四角いボタン (背景の罫線の色を間隔から見せる) -->

    <Style x:Key="ActionBarGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{DynamicResource OutlineColor}" />
    </Style>

    <!-- 面の中の操作の帯 (中身がないときも面の色のまま) -->
    <Style x:Key="PanelActionGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="ActionBarButtonBase"
           TargetType="Button">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="ActionBarButton"
           TargetType="Button"
           BasedOn="{StaticResource ActionBarButtonBase}">
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ActionBarStrongButton"
           TargetType="Button"
           BasedOn="{StaticResource ActionBarButtonBase}">
        <Setter Property="TextColor" Value="{DynamicResource OnSecondaryColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SecondaryPressedColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 面の中の小さな操作 (食後の品をお願いする、支払方法を変える) -->
    <Style x:Key="InlineActionButton"
           TargetType="Button">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainerColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Cart -->
    <!-- ================================================================================ -->

    <Style x:Key="CartPanelGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceColor}" />
    </Style>

    <Style x:Key="CartTitleGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="ColumnSpacing" Value="12" />
    </Style>

    <Style x:Key="CountBadgeBorder"
           TargetType="Border">
        <Setter Property="MinimumWidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryContainerColor}" />
    </Style>

    <Style x:Key="CountBadgeLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnPrimaryContainerColor}" />
    </Style>

    <Style x:Key="CartCollectionView"
           TargetType="CollectionView">
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <!-- 注文リストの行は 2 段: 名前と数量の増減 / 食後の印・オプション・金額 -->
    <Style x:Key="CartLineGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="16,8,12,8" />
        <Setter Property="RowSpacing" Value="4" />
        <Setter Property="ColumnSpacing" Value="8" />
    </Style>

    <Style x:Key="CartLineNameLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <!-- 列の間隔は食後の印がない行にも残ってオプションが名前より右に寄るので、間隔は印と金額の余白で空ける -->
    <Style x:Key="CartLineDetailGrid"
           TargetType="Grid">
        <Setter Property="MinimumHeightRequest" Value="24" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <!-- 選んだオプションは切らずに折り返して全部見せる -->
    <Style x:Key="CartLineOptionLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="LineBreakMode" Value="WordWrap" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- 食後などの小さな印 -->
    <Style x:Key="TagBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceVariantColor}" />
    </Style>

    <Style x:Key="CartTagBorder"
           TargetType="Border"
           BasedOn="{StaticResource TagBorder}">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <Style x:Key="TagLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="CartStepperGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="HorizontalOptions" Value="End" />
    </Style>

    <Style x:Key="CartQuantityLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="VerticalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="CartAmountLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="EmptyStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="24" />
        <Setter Property="Spacing" Value="8" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="EmptyGlyphLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="56" />
        <Setter Property="TextColor" Value="{DynamicResource OutlineColor}" />
    </Style>

    <Style x:Key="EmptyLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="EmptyHintLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{DynamicResource OnSurfaceVariantColor}" />
    </Style>

    <!-- 店舗の知らせ (ラストオーダーの前は注意の色。注文の一時停止とラストオーダーの後は画面で失敗の色に替える) -->
    <Style x:Key="StoreNoticeGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="20,12" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="{DynamicResource WarningColor}" />
    </Style>

    <Style x:Key="StoreNoticeGlyphLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{DynamicResource OnWarningColor}" />
    </Style>

    <Style x:Key="StoreNoticeLabel"
           TargetType="Label">
