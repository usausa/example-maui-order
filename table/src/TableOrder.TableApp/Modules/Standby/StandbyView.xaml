<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:markup="clr-namespace:TableOrder.TableApp.Markup"
             xmlns:terminal="clr-namespace:TableOrder.Terminal.Modules;assembly=TableOrder.Terminal"
             xmlns:strings="clr-namespace:TableOrder.TableApp.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.TableApp.Modules.Standby"
             x:Class="TableOrder.TableApp.Modules.Standby.StandbyView"
             x:DataType="{x:Type module:StandbyViewModel}"
             s:BindingContextResolver.Type="{x:Type module:StandbyViewModel}">

    <!-- 待受: 席にお客様がいないときと会計の後に出す。来店の開き方が席の店は人数を入れて始め、ほかの店は開いた知らせで注文の画面に進む -->
    <Grid Style="{StaticResource StandbyGrid}"
          RowDefinitions="Auto,*,Auto">
        <!-- brand / language -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto">
            <HorizontalStackLayout Grid.Column="0"
                                   Style="{StaticResource StandbyBrandStack}">
                <!-- ブランドの印 (長押しで PIN を確かめてスタッフメニューに入る、隠れた入口) -->
                <!-- TouchBehavior は付けた要素の BindingContext を受け継がないので、印の BindingContext を渡す -->
                <Border x:Name="BrandMark"
                        Style="{StaticResource StandbyMarkBorder}">
                    <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                    <Border.Behaviors>
                        <mct:TouchBehavior BindingContext="{Binding Source={x:Reference BrandMark}, Path=BindingContext, x:DataType={x:Type Border}}"
                                           LongPressCommand="{Binding StaffCommand}"
                                           LongPressDuration="{x:Static terminal:AppGestures.StaffLongPress}" />
                    </Border.Behaviors>
                    <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                    <!-- ロゴがなければ名前の頭の文字 -->
                    <Grid InputTransparent="True">
                        <Label Style="{StaticResource StandbyInitialLabel}"
                               IsVisible="{Binding Brand.HasLogo, Converter={StaticResource ReverseConverter}}"
                               Text="{Binding Brand.Initial}" />
                        <Image Style="{StaticResource BrandLogoImage}"
                               IsVisible="{Binding Brand.HasLogo}"
                               Source="{Binding Brand.LogoPath}" />
                    </Grid>
                </Border>
                <Label Style="{StaticResource StandbyBrandLabel}"
                       Text="{Binding Brand.Name}" />
            </HorizontalStackLayout>
            <Button Grid.Column="1"
                    Style="{StaticResource StandbyLanguageButton}"
                    Command="{Binding LanguageCommand}"
                    IsVisible="{Binding HasLanguages}"
                    ContentLayout="Left,12"
                    ImageSource="{x:Static markup:AppIcons.StandbyLanguage}"
                    Text="{Binding LanguageText}" />
        </Grid>

        <!-- message -->
        <VerticalStackLayout Grid.Row="1"
                             Style="{StaticResource StandbyStack}">
            <Label Style="{StaticResource StandbyTitleLabel}"
                   Text="{x:Static strings:AppResources.StandbyWelcome}" />
            <Label Style="{StaticResource StandbyMessageLabel}"
                   Text="{Binding Message}" />
            <Button Style="{StaticResource StandbyStartButton}"
                    Command="{Binding StartCommand}"
                    IsVisible="{Binding CanStart}"
                    ContentLayout="Left,16"
                    ImageSource="{x:Static markup:AppIcons.StandbyStart}"
                    Text="{x:Static strings:AppResources.StandbyStart}" />
        </VerticalStackLayout>

        <!-- table -->
        <Label Grid.Row="2"
               Style="{StaticResource StandbyFooterLabel}"
               Text="{Binding TableText}" />
    </Grid>

</ContentView>
