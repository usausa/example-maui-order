<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:strings="clr-namespace:TableOrder.TableApp.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.TableApp.Modules.Setup"
             x:Class="TableOrder.TableApp.Modules.Setup.SetupView"
             x:DataType="{x:Type module:SetupViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SetupViewModel}">

    <!-- 端末の設定: 接続先と端末の登録 (ペアリングコード)。起動の画面と同じくシステムの色にする -->
    <Grid Style="{StaticResource SystemScreenGrid}"
          RowDefinitions="72,1,*,Auto">
        <!-- header -->
        <Grid Grid.Row="0"
              Style="{StaticResource SystemHeaderGrid}"
              ColumnDefinitions="Auto,*">
            <Image Grid.Column="0"
                   Style="{StaticResource SystemHeaderLogoImage}"
                   Source="system_logo.png" />
            <Label Grid.Column="1"
                   Style="{StaticResource SystemHeaderLabel}"
                   Text="{x:Static strings:AppResources.SetupTitle}" />
        </Grid>
        <BoxView Grid.Row="1"
                 Style="{StaticResource SystemRule}" />

        <!-- form -->
        <ScrollView Grid.Row="2"
                    Style="{StaticResource PanelScroll}">
            <VerticalStackLayout Style="{StaticResource SetupFormStack}">
                <!-- endpoint (EMM が配っているときは入力の代わりに値を出す) -->
                <VerticalStackLayout Style="{StaticResource SetupFieldStack}">
                    <Label Style="{StaticResource SetupFieldLabel}"
                           Text="{x:Static strings:AppResources.SetupEndpoint}" />
                    <Entry Style="{StaticResource SetupEntry}"
                           IsVisible="{Binding IsEndPointManaged, Converter={StaticResource ReverseConverter}}"
                           Keyboard="Url"
                           Placeholder="https://"
                           Text="{Binding ApiEndPoint}" />
                    <Border Style="{StaticResource SetupManagedBorder}"
                            IsVisible="{Binding IsEndPointManaged}">
                        <Label Style="{StaticResource SetupManagedLabel}"
                               Text="{Binding ApiEndPoint}" />
                    </Border>
                    <Label Style="{StaticResource SetupHintLabel}"
                           Text="{Binding EndPointHintText}" />
                </VerticalStackLayout>

                <!-- registration (端末では変えられない値として出す) -->
                <VerticalStackLayout Style="{StaticResource SetupFieldStack}">
                    <Label Style="{StaticResource SetupFieldLabel}"
                           Text="{x:Static strings:AppResources.SetupRegistration}" />
                    <Border Style="{StaticResource SetupManagedBorder}">
                        <Label Style="{StaticResource SetupManagedLabel}"
                               Text="{Binding RegistrationText}" />
                    </Border>
                    <Label Style="{StaticResource SetupHintLabel}"
                           Text="{Binding RegistrationHintText}" />
                </VerticalStackLayout>

                <!-- pairing code -->
                <VerticalStackLayout Style="{StaticResource SetupFieldStack}">
                    <Label Style="{StaticResource SetupFieldLabel}"
                           Text="{x:Static strings:AppResources.SetupPairingCode}" />
                    <Border Style="{StaticResource SetupValueBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource SetupValueLabel}"
                                   Text="{Binding PairingCodeText}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SetupChangeButton}"
                                    Command="{Binding InputPairingCodeCommand}"
                                    Text="{x:Static strings:AppResources.SetupEnter}" />
                        </Grid>
                    </Border>
                    <Label Style="{StaticResource SetupHintLabel}"
                           Text="{x:Static strings:AppResources.SetupPairingCodeHint}" />
                </VerticalStackLayout>

                <!-- save (ペアリングコードを入れたときは登録してから起動する) -->
                <Button Style="{StaticResource SetupSaveButton}"
                        Command="{Binding SaveCommand}"
                        Text="{Binding SaveText}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- version -->
        <Label Grid.Row="3"
               Style="{StaticResource SystemFooterLabel}"
               Text="{Binding VersionText}" />
    </Grid>

</ContentView>
