<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:s="http://smart/maui"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           xmlns:fonts="clr-namespace:Fonts"
           xmlns:strings="clr-namespace:TableOrder.TableApp.Resources.Strings"
           xmlns:module="clr-namespace:TableOrder.TableApp.Modules.Menu"
           x:Class="TableOrder.TableApp.Modules.Menu.OrderConfirmView"
           x:DataType="{x:Type module:OrderConfirmViewModel}"
           s:BindingContextResolver.Type="{x:Type module:OrderConfirmViewModel}"
           WidthRequest="880"
           HeightRequest="760">

    <!-- 明細と合計、提案 (1 枠)、戻る / 注文する。送れたら同じ枠に受け付けの知らせを出す -->
    <Grid Style="{StaticResource DialogGrid}"
          RowDefinitions="64,1,*,Auto,1,Auto,Auto,1,80">
        <Label Grid.Row="0"
               Style="{StaticResource DialogTitleLabel}"
               Text="{x:Static strings:AppResources.ConfirmTitle}" />
        <BoxView Grid.Row="1"
                 Style="{StaticResource HorizontalRule}" />

        <!-- lines -->
        <CollectionView Grid.Row="2"
                        Style="{StaticResource ListCollectionView}"
                        ItemsSource="{Binding Lines}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:ConfirmLine}">
                    <Grid Style="{StaticResource FillGrid}"
                          RowDefinitions="Auto,1">
                        <Grid Grid.Row="0"
                              Style="{StaticResource ListLineGrid}"
                              ColumnDefinitions="*,80,120">
                            <VerticalStackLayout Grid.Column="0"
                                                 Style="{StaticResource ListLineTextStack}">
                                <HorizontalStackLayout Style="{StaticResource ListLineTitleStack}">
                                    <Label Style="{StaticResource ListLineNameLabel}"
                                           Text="{Binding Name}" />
                                    <Border Style="{StaticResource TagBorder}"
                                            IsVisible="{Binding IsAfterMeal}">
                                        <Label Style="{StaticResource TagLabel}"
                                               Text="{x:Static strings:AppResources.AfterMealTag}" />
                                    </Border>
                                </HorizontalStackLayout>
                                <Label Style="{StaticResource ListLineOptionLabel}"
                                       IsVisible="{Binding HasOptions}"
                                       Text="{Binding OptionText}" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1"
                                   Style="{StaticResource ListLineQuantityLabel}"
                                   Text="{Binding QuantityText}" />
                            <Label Grid.Column="2"
                                   Style="{StaticResource ListLineAmountLabel}"
                                   Text="{Binding AmountText}" />
                        </Grid>
                        <BoxView Grid.Row="1"
                                 Style="{StaticResource HorizontalVariantRule}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- suggestion -->
        <VerticalStackLayout Grid.Row="3"
                             Style="{StaticResource SuggestionStack}"
                             IsVisible="{Binding HasSuggestion}">
            <HorizontalStackLayout Style="{StaticResource SuggestionTitleStack}">
                <Label Style="{StaticResource SuggestionMessageLabel}"
                       Text="{Binding SuggestionMessage}" />
                <Label Style="{StaticResource SuggestionRemainingLabel}"
                       Text="{Binding SuggestionRemainingText}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Style="{StaticResource SuggestionItemStack}"
                                   BindableLayout.ItemsSource="{Binding SuggestItems}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type module:SuggestItem}">
                        <Border Style="{StaticResource SuggestionTileBorder}">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0"
                                                     Style="{StaticResource OptionTextStack}">
                                    <Label Style="{StaticResource OptionNameLabel}"
                                           Text="{Binding Name}" />
                                    <Label Style="{StaticResource OptionPriceLabel}"
                                           Text="{Binding PriceText}" />
                                </VerticalStackLayout>
                                <!-- ReSharper disable Xaml.BindingWithContextNotResolved -->
                                <Button Grid.Column="1"
                                        Style="{StaticResource SuggestionAddButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type module:OrderConfirmViewModel}}, Path=AddSuggestionCommand, x:DataType={x:Type module:OrderConfirmViewModel}}"
                                        CommandParameter="{Binding .}"
                                        Text="{x:Static strings:AppResources.SuggestionAdd}" />
                                <!-- ReSharper restore Xaml.BindingWithContextNotResolved -->
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </HorizontalStackLayout>
        </VerticalStackLayout>
        <BoxView Grid.Row="4"
                 Style="{StaticResource HorizontalRule}" />

        <!-- total -->
        <Grid Grid.Row="5"
              Style="{StaticResource DialogTotalGrid}"
              ColumnDefinitions="*,Auto,Auto">
            <Label Grid.Column="0"
                   Style="{StaticResource TotalCaptionLabel}"
                   Text="{x:Static strings:AppResources.TotalCaption}" />
            <Label Grid.Column="1"
                   Style="{StaticResource TotalCountLabel}"
                   Text="{Binding CountText}" />
            <Label Grid.Column="2"
                   Style="{StaticResource TotalLabel}"
                   Text="{Binding TotalText}" />
        </Grid>

        <!-- error -->
        <Label Grid.Row="6"
               Style="{StaticResource DialogErrorLabel}"
               IsVisible="{Binding IsFailed}"
               Text="{Binding ErrorText}" />

        <!-- action -->
        <BoxView Grid.Row="7"
                 Style="{StaticResource HorizontalRule}" />
        <Grid Grid.Row="8"
              Style="{StaticResource DialogActionGrid}"
              ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Style="{StaticResource SecondaryActionButton}"
                    Command="{Binding BackCommand}"
                    Text="{x:Static strings:AppResources.CommonBack}" />
            <Button Grid.Column="1"
                    Style="{StaticResource PrimaryActionButton}"
                    Command="{Binding SubmitCommand}"
                    Text="{Binding SubmitText}" />
        </Grid>

        <!-- completed -->
        <Grid Grid.Row="0" Grid.RowSpan="9"
              Style="{StaticResource CompletedGrid}"
              IsVisible="{Binding IsCompleted}">
            <VerticalStackLayout Style="{StaticResource CompletedStack}">
                <Label Style="{StaticResource CompletedGlyphLabel}"
                       Text="{x:Static fonts:MaterialIcons.Check_circle}" />
                <Label Style="{StaticResource CompletedTitleLabel}"
                       Text="{x:Static strings:AppResources.ConfirmDoneTitle}" />
                <Label Style="{StaticResource CompletedMessageLabel}"
                       Text="{x:Static strings:AppResources.ConfirmDoneMessage}" />
            </VerticalStackLayout>
        </Grid>
    </Grid>

</mct:Popup>
