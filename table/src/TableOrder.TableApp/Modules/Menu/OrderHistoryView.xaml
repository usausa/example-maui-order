<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
           xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
           xmlns:s="http://smart/maui"
           xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
           xmlns:fonts="clr-namespace:Fonts"
           xmlns:strings="clr-namespace:TableOrder.TableApp.Resources.Strings"
           xmlns:module="clr-namespace:TableOrder.TableApp.Modules.Menu"
           x:Class="TableOrder.TableApp.Modules.Menu.OrderHistoryView"
           x:DataType="{x:Type module:OrderHistoryViewModel}"
           s:BindingContextResolver.Type="{x:Type module:OrderHistoryViewModel}"
           WidthRequest="960"
           HeightRequest="760">

    <!-- 送った注文と明細の状態 (調理中、まもなくお持ちします、お届け済み)、食後の品のお願い、これまでの合計 -->
    <Grid Style="{StaticResource DialogGrid}"
          RowDefinitions="64,1,*,1,Auto,1,80">
        <Label Grid.Row="0"
               Style="{StaticResource DialogTitleLabel}"
               Text="{x:Static strings:AppResources.HistoryTitle}" />
        <BoxView Grid.Row="1"
                 Style="{StaticResource HorizontalRule}" />

        <!-- orders -->
        <CollectionView Grid.Row="2"
                        Style="{StaticResource ListCollectionView}"
                        ItemsSource="{Binding Orders}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="{x:Type module:HistoryOrder}">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource HistoryOrderGrid}"
                              ColumnDefinitions="Auto,*">
                            <Label Grid.Column="0"
                                   Style="{StaticResource HistoryOrderLabel}"
                                   Text="{Binding Title}" />
                            <Label Grid.Column="1"
                                   Style="{StaticResource HistoryTimeLabel}"
                                   Text="{Binding TimeText}" />
                        </Grid>
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="{x:Type module:HistoryLine}">
                                    <Grid Style="{StaticResource FillGrid}"
                                          RowDefinitions="Auto,1">
                                        <Grid Grid.Row="0"
                                              Style="{StaticResource ListLineGrid}"
                                              ColumnDefinitions="*,72,112,200">
                                            <VerticalStackLayout Grid.Column="0"
                                                                 Style="{StaticResource ListLineTextStack}">
                                                <Label Style="{StaticResource ListLineNameLabel}"
                                                       Text="{Binding Name}" />
                                                <Label Style="{StaticResource ListLineOptionLabel}"
                                                       IsVisible="{Binding HasOptions}"
                                                       Text="{Binding OptionText}" />
                                            </VerticalStackLayout>
                                            <Label Grid.Column="1"
                                                   Style="{StaticResource ListLineQuantityLabel}"
                                                   Text="{Binding QuantityText}" />
                                            <Label Grid.Column="2"
                                                   Style="{StaticResource ListLineAmountLabel}"
                                                   Text="{Binding AmountText}" />
                                            <Border Grid.Column="3"
                                                    Style="{StaticResource StatusBorder}">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsCooking}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryContainerColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsReady}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                                                    </DataTrigger>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsDone}"
                                                                 Value="True">
                                                        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Label Style="{StaticResource StatusLabel}"
                                                       Text="{Binding StatusText}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsCooking}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource OnPrimaryContainerColor}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Label"
                                                                     Binding="{Binding IsReady}"
                                                                     Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource OnPrimaryColor}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </Grid>
                                        <BoxView Grid.Row="1"
                                                 Style="{StaticResource HorizontalVariantRule}" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        <VerticalStackLayout Grid.Row="2"
                             Style="{StaticResource EmptyStack}"
                             IsVisible="{Binding IsEmpty}">
            <Label Style="{StaticResource EmptyGlyphLabel}"
                   Text="{x:Static fonts:MaterialIcons.Receipt_long}" />
            <Label Style="{StaticResource EmptyLabel}"
                   Text="{x:Static strings:AppResources.HistoryEmpty}" />
        </VerticalStackLayout>
        <ActivityIndicator Grid.Row="2"
                           Style="{StaticResource LoadingIndicator}"
                           IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}" />
        <BoxView Grid.Row="3"
                 Style="{StaticResource HorizontalRule}" />

        <!-- held / total -->
        <Grid Grid.Row="4"
              Style="{StaticResource DialogTotalGrid}"
              ColumnDefinitions="Auto,Auto,*,Auto,Auto">
            <Label Grid.Column="0"
                   Style="{StaticResource HistoryHeldLabel}"
                   IsVisible="{Binding HasHeld}"
                   Text="{Binding HeldText}" />
            <Button Grid.Column="1"
                    Style="{StaticResource InlineActionButton}"
                    Command="{Binding ReleaseCommand}"
                    IsVisible="{Binding HasHeld}"
                    Text="{x:Static strings:AppResources.HistoryRelease}" />
            <Label Grid.Column="3"
                   Style="{StaticResource TotalCaptionLabel}"
                   Text="{x:Static strings:AppResources.HistoryTotal}" />
            <Label Grid.Column="4"
                   Style="{StaticResource TotalLabel}"
                   Text="{Binding TotalText}" />
        </Grid>

        <!-- action -->
        <BoxView Grid.Row="5"
                 Style="{StaticResource HorizontalRule}" />
        <Grid Grid.Row="6"
              Style="{StaticResource DialogActionGrid}">
            <Button Style="{StaticResource SecondaryActionButton}"
                    Command="{Binding CloseCommand}"
                    Text="{x:Static strings:AppResources.CommonClose}" />
        </Grid>
    </Grid>

</mct:Popup>
