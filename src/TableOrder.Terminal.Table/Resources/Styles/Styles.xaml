<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:s="http://smart/maui"
                    xmlns:behaviors="clr-namespace:TableOrder.Terminal.Table.Behaviors"
                    xmlns:controls="clr-namespace:TableOrder.Terminal.Table.Controls"
                    xmlns:fonts="clr-namespace:Fonts">

    <!-- 形は角丸・影・グラデーションを使わず、四角い面と罫線と色の面で組む。色は Colors.xaml の役割の名前だけを使う -->

    <!-- ================================================================================ -->
    <!-- Converter -->
    <!-- ================================================================================ -->

    <!-- Basic -->

    <s:ReverseConverter x:Key="ReverseConverter" />

    <s:NullToBoolConverter x:Key="NotEmptyConverter"
                           HandleEmptyString="True"
                           NullValue="False"
                           NonNullValue="True" />

    <s:CompareToBoolConverter x:Key="GreaterThanToBoolConverter"
                              Expression="{x:Static s:CompareExpressions.GreaterThan}" />

    <s:ColorToBrushConverter x:Key="ColorToBrushConverter" />

    <!-- ================================================================================ -->
    <!-- Main -->
    <!-- ================================================================================ -->

    <Style x:Key="MainGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <!-- 画面を切り替える間に見える地は、起動の画面とスプラッシュの地に揃える -->
    <Style x:Key="ContainerLayout"
           TargetType="AbsoluteLayout">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalOptions" Value="Fill" />
        <Setter Property="VerticalOptions" Value="Fill" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Layout -->
    <!-- ================================================================================ -->

    <Style x:Key="ScreenGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource CanvasColor}" />
    </Style>

    <Style x:Key="FillGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
    </Style>

    <!-- 面 (注文リスト、明細、支払) -->
    <Style x:Key="PanelGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
    </Style>

    <!-- 面の区切りは 1 本の罫線にする -->

    <Style x:Key="HorizontalRule"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource OutlineColor}" />
    </Style>

    <Style x:Key="VerticalRule"
           TargetType="BoxView">
        <Setter Property="WidthRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource OutlineColor}" />
    </Style>

    <!-- 一覧の行の間の薄い区切り -->
    <Style x:Key="HorizontalVariantRule"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource OutlineVariantColor}" />
    </Style>

    <Style x:Key="LoadingIndicator"
           TargetType="ActivityIndicator">
        <Setter Property="WidthRequest" Value="48" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Color" Value="{StaticResource PrimaryColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- System -->
    <!-- ================================================================================ -->

    <!-- 起動と端末の設定。チェーンの色を使わず、System の役割の色で組む -->

    <Style x:Key="SystemScreenGrid"
           TargetType="Grid">
        <Setter Property="RowSpacing" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
    </Style>

    <Style x:Key="SystemHeaderGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
    </Style>

    <Style x:Key="SystemHeaderLogoImage"
           TargetType="Image">
        <Setter Property="Margin" Value="24,0,16,0" />
        <Setter Property="WidthRequest" Value="40" />
        <Setter Property="HeightRequest" Value="40" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SystemHeaderLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SystemRule"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="Color" Value="{StaticResource SystemOutlineColor}" />
    </Style>

    <Style x:Key="SystemLogoImage"
           TargetType="Image">
        <Setter Property="WidthRequest" Value="120" />
        <Setter Property="HeightRequest" Value="120" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="SystemWordmarkLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SystemFooterLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="0,0,0,24" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="SystemButtonBase"
           TargetType="Button">
        <Setter Property="HeightRequest" Value="72" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="SystemPrimaryButton"
           TargetType="Button"
           BasedOn="{StaticResource SystemButtonBase}">
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemAccentColor}" />
                            <Setter Property="TextColor" Value="{StaticResource OnSystemAccentColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemAccentPressedColor}" />
                            <Setter Property="TextColor" Value="{StaticResource OnSystemAccentColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemOutlineColor}" />
                            <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SystemSecondaryButton"
           TargetType="Button"
           BasedOn="{StaticResource SystemButtonBase}">
        <Setter Property="BorderWidth" Value="1" />
        <Setter Property="BorderColor" Value="{StaticResource SystemOutlineColor}" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Startup -->

    <Style x:Key="StartupStack"
           TargetType="VerticalStackLayout">
        <Setter Property="WidthRequest" Value="480" />
        <Setter Property="Spacing" Value="20" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!-- 進み具合は罫線の太さの帯にし、伸ばす帯は左端から ScaleX で伸ばす -->
    <Style x:Key="StartupProgressGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0,28,0,0" />
        <Setter Property="HeightRequest" Value="4" />
    </Style>

    <Style x:Key="StartupProgressTrack"
           TargetType="BoxView">
        <Setter Property="Color" Value="{StaticResource SystemOutlineColor}" />
    </Style>

    <Style x:Key="StartupProgressBar"
           TargetType="BoxView">
        <Setter Property="AnchorX" Value="0" />
        <Setter Property="Color" Value="{StaticResource SystemAccentColor}" />
    </Style>

    <Style x:Key="StartupStepLabel"
           TargetType="Label">
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="StartupActionGrid"
           TargetType="Grid">
        <Setter Property="Margin" Value="0,16,0,0" />
        <Setter Property="ColumnSpacing" Value="16" />
    </Style>

    <!-- Setup -->

    <Style x:Key="SetupFormStack"
           TargetType="VerticalStackLayout">
        <Setter Property="WidthRequest" Value="720" />
        <Setter Property="Padding" Value="0,48" />
        <Setter Property="Spacing" Value="40" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="SetupFieldStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Spacing" Value="10" />
    </Style>

    <Style x:Key="SetupFieldLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SetupValueBorder"
           TargetType="Border">
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Stroke" Value="{StaticResource SystemOutlineColor}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
    </Style>

    <Style x:Key="SetupValueLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="24,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
    </Style>

    <Style x:Key="SetupChangeButton"
           TargetType="Button">
        <Setter Property="WidthRequest" Value="160" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemCanvasColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SystemOutlineColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="SetupHintLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
    </Style>

    <Style x:Key="SetupEntry"
           TargetType="Entry">
        <Setter Property="HeightRequest" Value="64" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="TextColor" Value="{StaticResource OnSystemCanvasColor}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource OnSystemCanvasVariantColor}" />
        <Setter Property="BackgroundColor" Value="{StaticResource SystemSurfaceColor}" />
        <Setter Property="behaviors:Border.Color" Value="{StaticResource SystemOutlineColor}" />
        <Setter Property="behaviors:Border.Width" Value="1" />
        <Setter Property="behaviors:Border.Padding" Value="20,12" />
    </Style>

    <Style x:Key="SetupSaveButton"
           TargetType="Button"
           BasedOn="{StaticResource SystemPrimaryButton}">
        <Setter Property="HeightRequest" Value="80" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Header -->
    <!-- ================================================================================ -->

    <Style x:Key="HeaderGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="0" />
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
    </Style>

    <Style x:Key="BrandMarkBorder"
           TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
    </Style>

    <Style x:Key="BrandMarkImage"
           TargetType="Image">
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="BrandLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="20,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="HeaderItemStack"
           TargetType="VerticalStackLayout">
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Spacing" Value="0" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="HeaderCaptionLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariantColor}" />
    </Style>

    <Style x:Key="HeaderValueLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="HeaderButton"
           TargetType="Button">
        <Setter Property="MinimumWidthRequest" Value="200" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariantColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="PanelTitleGrid"
           TargetType="Grid">
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="ColumnSpacing" Value="12" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
    </Style>

    <Style x:Key="PanelTitleLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="PanelCaptionLabel"
           TargetType="Label">
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceVariantColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Category -->
    <!-- ================================================================================ -->

    <!-- タブは区切り線で並べた四角い枠にし、選択中は主色の面で示す (選択は DataTrigger で替える) -->

    <Style x:Key="CategoryBarScroll"
           TargetType="ScrollView">
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <!-- 区切り線の色を間隔から見せる。最後のタブの右にも区切り線を出し、余りは面の色のままにする -->
    <Style x:Key="CategoryBarStack"
           TargetType="HorizontalStackLayout">
        <Setter Property="Padding" Value="0,0,1,0" />
        <Setter Property="Spacing" Value="1" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="{StaticResource OutlineColor}" />
    </Style>

    <Style x:Key="CategoryTabBorder"
           TargetType="Border">
        <Setter Property="MinimumWidthRequest" Value="144" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
    </Style>

    <Style x:Key="CategoryTabLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceColor}" />
    </Style>

    <!-- ================================================================================ -->
    <!-- Menu -->
    <!-- ================================================================================ -->

    <!-- カードは 4 列。料理の絵 (4:3) を主役にし、名前は 2 行まで、価格と + を下の帯に置く -->

    <Style x:Key="MenuCollectionView"
           TargetType="CollectionView">
        <Setter Property="Margin" Value="24,0" />
        <Setter Property="SelectionMode" Value="None" />
        <Setter Property="behaviors:Scroll.DisableOverScroll" Value="True" />
    </Style>

    <Style x:Key="MenuGapBoxView"
           TargetType="BoxView">
        <Setter Property="HeightRequest" Value="24" />
    </Style>

    <Style x:Key="MenuCardBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
    </Style>

    <Style x:Key="MenuCardImageGrid"
           TargetType="Grid">
        <Setter Property="HeightRequest" Value="168" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariantColor}" />
    </Style>

    <Style x:Key="MenuCardImage"
           TargetType="Image">
        <Setter Property="Aspect" Value="AspectFill" />
    </Style>

    <Style x:Key="MenuBadgeBorder"
           TargetType="Border">
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="VerticalOptions" Value="Start" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="Rectangle" />
        <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
    </Style>

    <Style x:Key="MenuBadgeLabel"
           TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnPrimaryColor}" />
    </Style>

    <!-- 売り切れは絵に幕をかけて文字を重ねる -->
    <Style x:Key="SoldOutGrid"
           TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource ScrimColor}" />
    </Style>

    <Style x:Key="SoldOutLabel"
           TargetType="Label">
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnScrimColor}" />
    </Style>

    <Style x:Key="MenuCardNameLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="16,12,16,0" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="MaxLines" Value="2" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="MenuCardPriceLabel"
           TargetType="Label">
        <Setter Property="Margin" Value="16,0,0,0" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceColor}" />
    </Style>

    <Style x:Key="MenuCardAddButton"
           TargetType="Button">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontFamily" Value="{x:Static fonts:MaterialIcons.FontFamily}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryContainerColor}" />
                            <Setter Property="TextColor" Value="{StaticResource OnPrimaryContainerColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                            <Setter Property="TextColor" Value="{StaticResource OnPrimaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ================================================================================ -->
    <!-- Action -->
    <!-- ================================================================================ -->

    <!-- 下部の操作は区切り線で並べた四角いボタン (背景の罫線の色を間隔から見せる) -->

    <Style x:Key="ActionBarGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="1" />
        <Setter Property="BackgroundColor" Value="{StaticResource OutlineColor}" />
    </Style>

    <!-- 面の中の操作の帯 (中身がないときも面の色のまま) -->
    <Style x:Key="PanelActionGrid"
           TargetType="Grid">
        <Setter Property="ColumnSpacing" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
    </Style>

    <Style x:Key="ActionBarButtonBase"
           TargetType="Button">
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <Style x:Key="ActionBarButton"
           TargetType="Button"
           BasedOn="{StaticResource ActionBarButtonBase}">
        <Setter Property="TextColor" Value="{StaticResource OnSurfaceColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceVariantColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <Style x:Key="ActionBarStrongButton"
           TargetType="Button"
           BasedOn="{StaticResource ActionBarButtonBase}">
        <Setter Property="TextColor" Value="{StaticResource OnSecondaryColor}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SecondaryColor}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource SecondaryPressedColor}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- 面の中の小さな操作 (食後の品をお願いする、支払方法を変える) -->
    <Style x:Key="InlineActionButton"
