<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:strings="clr-namespace:TableOrder.Terminal.Table.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.Terminal.Table.Modules.Setup"
             x:Class="TableOrder.Terminal.Table.Modules.Setup.SetupView"
             x:DataType="{x:Type module:SetupViewModel}"
             s:BindingContextResolver.Type="{x:Type module:SetupViewModel}">

    <!-- 端末の設定: 置くテーブルと接続先。起動の画面と同じくシステムの色にする -->
    <Grid Style="{StaticResource SystemScreenGrid}"
          RowDefinitions="72,1,*,Auto">
        <!-- header -->
        <Grid Grid.Row="0"
              Style="{StaticResource SystemHeaderGrid}"
              ColumnDefinitions="Auto,*">
            <Image Grid.Column="0"
                   Style="{StaticResource SystemHeaderLogoImage}"
                   Source="system_logo.png" />
            <Label Grid.Column="1"
                   Style="{StaticResource SystemHeaderLabel}"
                   Text="{x:Static strings:AppResources.SetupTitle}" />
        </Grid>
        <BoxView Grid.Row="1"
                 Style="{StaticResource SystemRule}" />

        <!-- form -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Style="{StaticResource SetupFormStack}">
                <!-- table -->
                <VerticalStackLayout Style="{StaticResource SetupFieldStack}">
                    <Label Style="{StaticResource SetupFieldLabel}"
                           Text="{x:Static strings:AppResources.SetupTableNo}" />
                    <Border Style="{StaticResource SetupValueBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Style="{StaticResource SetupValueLabel}"
                                   Text="{Binding TableNoText}" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource SetupChangeButton}"
                                    Command="{Binding InputTableNoCommand}"
                                    Text="{x:Static strings:AppResources.SetupChange}" />
                        </Grid>
                    </Border>
                    <Label Style="{StaticResource SetupHintLabel}"
                           Text="{x:Static strings:AppResources.SetupTableNoHint}" />
                </VerticalStackLayout>

                <!-- endpoint -->
                <VerticalStackLayout Style="{StaticResource SetupFieldStack}">
                    <Label Style="{StaticResource SetupFieldLabel}"
                           Text="{x:Static strings:AppResources.SetupEndpoint}" />
                    <Entry Style="{StaticResource SetupEntry}"
                           Keyboard="Url"
                           Placeholder="https://"
                           Text="{Binding ApiEndPoint}" />
                    <Label Style="{StaticResource SetupHintLabel}"
                           Text="{x:Static strings:AppResources.SetupEndpointHint}" />
                </VerticalStackLayout>

                <!-- save -->
                <Button Style="{StaticResource SetupSaveButton}"
                        Command="{Binding SaveCommand}"
                        Text="{x:Static strings:AppResources.SetupSave}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- version -->
        <Label Grid.Row="3"
               Style="{StaticResource SystemFooterLabel}"
               Text="{Binding VersionText}" />
    </Grid>

</ContentView>
