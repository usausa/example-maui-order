<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:markup="clr-namespace:TableOrder.Terminal.Table.Markup"
             xmlns:controls="clr-namespace:TableOrder.Terminal.Table.Controls"
             xmlns:strings="clr-namespace:TableOrder.Terminal.Table.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.Terminal.Table.Modules.Checkout"
             x:Class="TableOrder.Terminal.Table.Modules.Checkout.CheckoutView"
             x:DataType="{x:Type module:CheckoutViewModel}"
             s:BindingContextResolver.Type="{x:Type module:CheckoutViewModel}">

    <!-- 注文の画面と同じ帯の組み方で、左に明細と合計、右に支払の段階 (方法を選ぶ、QR / カードで払う、お礼) を置く -->
    <Grid Style="{StaticResource ScreenGrid}"
          RowDefinitions="64,1,*">
        <!-- header -->
        <Grid Grid.Row="0"
              Style="{StaticResource HeaderGrid}"
              ColumnDefinitions="64,*,Auto,1,Auto">
            <Border Grid.Column="0"
                    Style="{StaticResource BrandMarkBorder}">
                <Image Style="{StaticResource BrandMarkImage}"
                       Source="{x:Static markup:AppIcons.Brand}" />
            </Border>
            <Label Grid.Column="1"
                   Style="{StaticResource BrandLabel}"
                   Text="{x:Static strings:AppResources.BrandName}" />
            <VerticalStackLayout Grid.Column="2"
                                 Style="{StaticResource HeaderItemStack}">
                <Label Style="{StaticResource HeaderCaptionLabel}"
                       Text="{x:Static strings:AppResources.HeaderTable}" />
                <Label Style="{StaticResource HeaderValueLabel}"
                       Text="{Binding TableText}" />
            </VerticalStackLayout>
            <BoxView Grid.Column="3"
                     Style="{StaticResource VerticalRule}" />
            <VerticalStackLayout Grid.Column="4"
                                 Style="{StaticResource HeaderItemStack}">
                <Label Style="{StaticResource HeaderCaptionLabel}"
                       Text="{x:Static strings:AppResources.HeaderGuests}" />
                <Label Style="{StaticResource HeaderValueLabel}"
                       Text="{Binding GuestsText}" />
            </VerticalStackLayout>
        </Grid>
        <BoxView Grid.Row="1"
                 Style="{StaticResource HorizontalRule}" />

        <!-- body -->
        <Grid Grid.Row="2"
              Style="{StaticResource FillGrid}"
              ColumnDefinitions="*,1,560">
            <!-- bill -->
            <Grid Grid.Column="0"
                  Style="{StaticResource PanelGrid}"
                  RowDefinitions="64,1,*,1,Auto,1,80">
                <Grid Grid.Row="0"
                      Style="{StaticResource PanelTitleGrid}"
                      ColumnDefinitions="*,Auto">
                    <Label Grid.Column="0"
                           Style="{StaticResource PanelTitleLabel}"
                           Text="{x:Static strings:AppResources.CheckoutDetails}" />
                    <Label Grid.Column="1"
                           Style="{StaticResource PanelCaptionLabel}"
                           Text="{Binding CountText}" />
                </Grid>
                <BoxView Grid.Row="1"
                         Style="{StaticResource HorizontalRule}" />

                <CollectionView Grid.Row="2"
                                Style="{StaticResource BillCollectionView}"
                                ItemsSource="{Binding Lines}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="{x:Type module:CheckoutLine}">
                            <Grid Style="{StaticResource FillGrid}"
                                  RowDefinitions="Auto,1">
                                <Grid Grid.Row="0"
                                      Style="{StaticResource ListLineGrid}"
                                      ColumnDefinitions="*,80,140">
                                    <VerticalStackLayout Grid.Column="0"
                                                         Style="{StaticResource ListLineTextStack}">
                                        <Label Style="{StaticResource ListLineNameLabel}"
                                               Text="{Binding Name}" />
                                        <Label Style="{StaticResource ListLineOptionLabel}"
                                               IsVisible="{Binding HasOptions}"
                                               Text="{Binding OptionText}" />
                                    </VerticalStackLayout>
                                    <Label Grid.Column="1"
                                           Style="{StaticResource ListLineQuantityLabel}"
                                           Text="{Binding QuantityText}" />
                                    <Label Grid.Column="2"
                                           Style="{StaticResource ListLineAmountLabel}"
                                           Text="{Binding AmountText}" />
                                </Grid>
                                <BoxView Grid.Row="1"
                                         Style="{StaticResource HorizontalVariantRule}" />
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                <BoxView Grid.Row="3"
                         Style="{StaticResource HorizontalRule}" />

                <!-- summary -->
                <VerticalStackLayout Grid.Row="4"
                                     Style="{StaticResource BillSummaryStack}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0"
                               Style="{StaticResource TotalCaptionLabel}"
                               Text="{x:Static strings:AppResources.CheckoutTotal}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource BillTotalLabel}"
                               Text="{Binding TotalText}" />
                    </Grid>
                    <Label Style="{StaticResource BillNoteLabel}"
                           Text="{Binding TaxText}" />
                    <Label Style="{StaticResource BillNoteLabel}"
                           IsVisible="{Binding HasSplit}"
                           Text="{Binding SplitText}" />
                    <Label Style="{StaticResource BillWarningLabel}"
                           IsVisible="{Binding HasUnserved}"
                           Text="{x:Static strings:AppResources.CheckoutUnserved}" />
                </VerticalStackLayout>
                <BoxView Grid.Row="5"
                         Style="{StaticResource HorizontalRule}" />

                <Grid Grid.Row="6"
                      Style="{StaticResource PanelActionGrid}">
                    <Button Style="{StaticResource ActionBarButton}"
                            Command="{Binding BackCommand}"
                            ContentLayout="Left,12"
                            ImageSource="{x:Static markup:AppIcons.Back}"
                            IsVisible="{Binding IsCompleted, Converter={StaticResource ReverseConverter}}"
                            Text="{x:Static strings:AppResources.CheckoutBackToMenu}" />
                </Grid>
            </Grid>

            <BoxView Grid.Column="1"
                     Style="{StaticResource VerticalRule}" />

            <!-- payment -->
            <Grid Grid.Column="2"
                  Style="{StaticResource PanelGrid}"
                  RowDefinitions="64,1,*,1,80">
                <Grid Grid.Row="0"
                      Style="{StaticResource PanelTitleGrid}">
                    <Label Style="{StaticResource PanelTitleLabel}"
                           Text="{Binding PanelTitle}" />
                </Grid>
                <BoxView Grid.Row="1"
                         Style="{StaticResource HorizontalRule}" />

                <Grid Grid.Row="2"
                      Style="{StaticResource FillGrid}">
                    <!-- loading -->
                    <ActivityIndicator Style="{StaticResource LoadingIndicator}"
                                       IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}" />

                    <!-- method -->
                    <VerticalStackLayout Style="{StaticResource PaymentStack}"
                                         IsVisible="{Binding IsMethod}">
                        <Label Style="{StaticResource PaymentAmountCaptionLabel}"
                               Text="{x:Static strings:AppResources.CheckoutTotal}" />
                        <Label Style="{StaticResource PaymentAmountLabel}"
                               Text="{Binding TotalText}" />
                        <Label Style="{StaticResource DialogErrorLabel}"
                               IsVisible="{Binding HasError}"
                               Text="{Binding ErrorText}" />
                        <Border Style="{StaticResource MethodTileBorder}"
                                IsVisible="{Binding CanUseQrCode}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding QrCodeCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0"
                                       Style="{StaticResource MethodGlyphLabel}"
                                       Text="{x:Static fonts:MaterialIcons.Qr_code_2}" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Style="{StaticResource MethodTextStack}">
                                    <Label Style="{StaticResource MethodNameLabel}"
                                           Text="{x:Static strings:AppResources.MethodQrCode}" />
                                    <Label Style="{StaticResource MethodHintLabel}"
                                           Text="{x:Static strings:AppResources.MethodQrCodeHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MethodTileBorder}"
                                IsVisible="{Binding CanUseCreditCard}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CreditCardCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0"
                                       Style="{StaticResource MethodGlyphLabel}"
                                       Text="{x:Static fonts:MaterialIcons.Credit_card}" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Style="{StaticResource MethodTextStack}">
                                    <Label Style="{StaticResource MethodNameLabel}"
                                           Text="{x:Static strings:AppResources.MethodCreditCard}" />
                                    <Label Style="{StaticResource MethodHintLabel}"
                                           Text="{x:Static strings:AppResources.MethodCreditCardHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource MethodTileBorder}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RegisterCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*">
                                <Label Grid.Column="0"
                                       Style="{StaticResource MethodGlyphLabel}"
                                       Text="{x:Static fonts:MaterialIcons.Point_of_sale}" />
                                <VerticalStackLayout Grid.Column="1"
                                                     Style="{StaticResource MethodTextStack}">
                                    <Label Style="{StaticResource MethodNameLabel}"
                                           Text="{x:Static strings:AppResources.MethodRegister}" />
                                    <Label Style="{StaticResource MethodHintLabel}"
                                           Text="{x:Static strings:AppResources.MethodRegisterHint}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- qr code -->
                    <VerticalStackLayout Style="{StaticResource PaymentCenterStack}"
                                         IsVisible="{Binding IsQrCode}">
                        <Label Style="{StaticResource PaymentAmountLabel}"
                               Text="{Binding TotalText}" />
                        <Border Style="{StaticResource QrFrameBorder}">
                            <controls:QrCodeView Style="{StaticResource PaymentQrCodeView}"
                                                 Text="{Binding QrValue}" />
                        </Border>
                        <Label Style="{StaticResource PaymentMessageLabel}"
                               Text="{x:Static strings:AppResources.QrInstruction}" />
                    </VerticalStackLayout>

                    <!-- credit card -->
                    <VerticalStackLayout Style="{StaticResource PaymentCenterStack}"
                                         IsVisible="{Binding IsCreditCard}">
                        <Label Style="{StaticResource PaymentAmountLabel}"
                               Text="{Binding TotalText}" />
                        <Label Style="{StaticResource PaymentGlyphLabel}"
                               Text="{x:Static fonts:MaterialIcons.Contactless}" />
                        <Label Style="{StaticResource PaymentMessageLabel}"
                               Text="{x:Static strings:AppResources.CardInstruction}" />
                    </VerticalStackLayout>

                    <!-- register -->
                    <VerticalStackLayout Style="{StaticResource PaymentCenterStack}"
                                         IsVisible="{Binding IsRegister}">
                        <Label Style="{StaticResource PaymentGlyphLabel}"
                               Text="{x:Static fonts:MaterialIcons.Point_of_sale}" />
                        <Label Style="{StaticResource PaymentTitleLabel}"
                               Text="{x:Static strings:AppResources.RegisterTitle}" />
                        <Label Style="{StaticResource PaymentMessageLabel}"
                               Text="{Binding RegisterMessage}" />
                    </VerticalStackLayout>

                    <!-- completed -->
                    <VerticalStackLayout Style="{StaticResource PaymentCenterStack}"
                                         IsVisible="{Binding IsCompleted}">
                        <Label Style="{StaticResource CompletedGlyphLabel}"
                               Text="{x:Static fonts:MaterialIcons.Check_circle}" />
                        <Label Style="{StaticResource PaymentTitleLabel}"
                               Text="{x:Static strings:AppResources.ThanksTitle}" />
                        <Label Style="{StaticResource PaymentMessageLabel}"
                               Text="{x:Static strings:AppResources.ThanksMessage}" />
                        <Grid Style="{StaticResource ReceiptGrid}"
                              ColumnDefinitions="Auto,*"
                              IsVisible="{Binding HasReceipt}">
                            <Border Grid.Column="0"
                                    Style="{StaticResource ReceiptFrameBorder}">
                                <controls:QrCodeView Style="{StaticResource ReceiptQrCodeView}"
                                                     Text="{Binding ReceiptValue}" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1"
                                                 Style="{StaticResource MethodTextStack}">
                                <Label Style="{StaticResource MethodNameLabel}"
                                       Text="{x:Static strings:AppResources.ReceiptCaption}" />
                                <Label Style="{StaticResource MethodHintLabel}"
                                       Text="{x:Static strings:AppResources.ReceiptHint}" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Grid>
                <BoxView Grid.Row="3"
                         Style="{StaticResource HorizontalRule}" />

                <!-- payment action -->
                <Grid Grid.Row="4"
                      Style="{StaticResource PanelActionGrid}">
                    <Grid Style="{StaticResource WaitingGrid}"
                          ColumnDefinitions="Auto,*,Auto"
                          IsVisible="{Binding CanChangeMethod}">
                        <ActivityIndicator Grid.Column="0"
                                           Style="{StaticResource WaitingIndicator}"
                                           IsRunning="{Binding IsWaiting}"
                                           IsVisible="{Binding IsWaiting}" />
                        <Label Grid.Column="1"
                               Style="{StaticResource WaitingLabel}"
                               IsVisible="{Binding IsWaiting}"
                               Text="{x:Static strings:AppResources.PaymentWaiting}" />
                        <Button Grid.Column="2"
                                Style="{StaticResource InlineActionButton}"
                                Command="{Binding ChangeMethodCommand}"
                                Text="{x:Static strings:AppResources.PaymentChange}" />
                    </Grid>
                    <Button Style="{StaticResource ActionBarStrongButton}"
                            Command="{Binding FinishCommand}"
                            IsVisible="{Binding IsCompleted}"
                            Text="{x:Static strings:AppResources.CommonClose}" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</ContentView>
