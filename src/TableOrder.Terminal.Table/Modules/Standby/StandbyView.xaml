<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:markup="clr-namespace:TableOrder.Terminal.Table.Markup"
             xmlns:strings="clr-namespace:TableOrder.Terminal.Table.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.Terminal.Table.Modules.Standby"
             x:Class="TableOrder.Terminal.Table.Modules.Standby.StandbyView"
             x:DataType="{x:Type module:StandbyViewModel}"
             s:BindingContextResolver.Type="{x:Type module:StandbyViewModel}">

    <!-- 待受: 席にお客様がいないときと会計の後に出す。お客様が始められる店 (selfStart) はどこをタッチしても始められる -->
    <!-- タッチで始める面は一番下に敷き、言語の切り替えと始めるボタン以外はタッチを下の面へ通す -->
    <Grid Style="{StaticResource StandbyGrid}"
          RowDefinitions="Auto,*,Auto">
        <!-- touch -->
        <BoxView Grid.Row="0" Grid.RowSpan="3"
                 Margin="{StaticResource StandbyTouchMargin}">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding StartCommand}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- brand / language -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              CascadeInputTransparent="False"
              InputTransparent="True">
            <HorizontalStackLayout Grid.Column="0"
                                   Style="{StaticResource StandbyBrandStack}"
                                   InputTransparent="True">
                <Border Style="{StaticResource StandbyMarkBorder}">
                    <Label Style="{StaticResource StandbyMarkLabel}"
                           Text="{x:Static markup:AppIcons.BrandGlyph}" />
                </Border>
                <Label Style="{StaticResource StandbyBrandLabel}"
                       Text="{x:Static strings:AppResources.BrandName}" />
            </HorizontalStackLayout>
            <Button Grid.Column="1"
                    Style="{StaticResource StandbyLanguageButton}"
                    Command="{Binding LanguageCommand}"
                    ContentLayout="Left,12"
                    ImageSource="{x:Static markup:AppIcons.StandbyLanguage}"
                    Text="{Binding LanguageText}" />
        </Grid>

        <!-- message -->
        <VerticalStackLayout Grid.Row="1"
                             Style="{StaticResource StandbyStack}"
                             CascadeInputTransparent="False"
                             InputTransparent="True">
            <Label Style="{StaticResource StandbyTitleLabel}"
                   InputTransparent="True"
                   Text="{x:Static strings:AppResources.StandbyWelcome}" />
            <Label Style="{StaticResource StandbyMessageLabel}"
                   InputTransparent="True"
                   Text="{Binding Message}" />
            <Button Style="{StaticResource StandbyStartButton}"
                    Command="{Binding StartCommand}"
                    ContentLayout="Left,16"
                    ImageSource="{x:Static markup:AppIcons.Touch}"
                    IsVisible="{Binding CanStart}"
                    Text="{x:Static strings:AppResources.StandbyStart}" />
        </VerticalStackLayout>

        <!-- table -->
        <Label Grid.Row="2"
               Style="{StaticResource StandbyFooterLabel}"
               InputTransparent="True"
               Text="{Binding TableText}" />
    </Grid>

</ContentView>
