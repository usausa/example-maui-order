<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:s="http://smart/maui"
             xmlns:strings="clr-namespace:TableOrder.Terminal.Table.Resources.Strings"
             xmlns:module="clr-namespace:TableOrder.Terminal.Table.Modules.Startup"
             x:Class="TableOrder.Terminal.Table.Modules.Startup.StartupView"
             x:DataType="{x:Type module:StartupViewModel}"
             s:BindingContextResolver.Type="{x:Type module:StartupViewModel}">

    <!-- 起動: システムのロゴと準備の進み具合。チェーンの色を使わず、スプラッシュと同じ地にする -->
    <Grid Style="{StaticResource SystemScreenGrid}"
          RowDefinitions="*,Auto,*,Auto">
        <VerticalStackLayout Grid.Row="1"
                             Style="{StaticResource StartupStack}">
            <!-- logo -->
            <Image Style="{StaticResource SystemLogoImage}"
                   Source="system_logo.png" />
            <Label Style="{StaticResource SystemWordmarkLabel}"
                   Text="TableOrder" />

            <!-- progress -->
            <Grid Style="{StaticResource StartupProgressGrid}">
                <BoxView Style="{StaticResource StartupProgressTrack}" />
                <BoxView Style="{StaticResource StartupProgressBar}"
                         ScaleX="{Binding Progress}" />
            </Grid>
            <Label Style="{StaticResource StartupStepLabel}"
                   Text="{Binding StepText}">
                <Label.Triggers>
                    <DataTrigger TargetType="Label"
                                 Binding="{Binding IsFailed}"
                                 Value="True">
                        <Setter Property="TextColor" Value="{StaticResource ErrorColor}" />
                    </DataTrigger>
                </Label.Triggers>
            </Label>

            <!-- failure -->
            <Grid Style="{StaticResource StartupActionGrid}"
                  ColumnDefinitions="*,*"
                  IsVisible="{Binding IsFailed}">
                <Button Grid.Column="0"
                        Style="{StaticResource SystemSecondaryButton}"
                        Command="{Binding SetupCommand}"
                        Text="{x:Static strings:AppResources.StartupSetup}" />
                <Button Grid.Column="1"
                        Style="{StaticResource SystemPrimaryButton}"
                        Command="{Binding RetryCommand}"
                        Text="{x:Static strings:AppResources.StartupRetry}" />
            </Grid>
        </VerticalStackLayout>

        <!-- version -->
        <Label Grid.Row="3"
               Style="{StaticResource SystemFooterLabel}"
               Text="{Binding VersionText}" />
    </Grid>

</ContentView>
